---
import { Header, Button, Footer, AnnouncementBar } from '@components/odyssey-theme';
import CartDrawer from '../components/core/CartDrawer.astro';
import Layout from './Base.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import Logo from '../components/Logo.astro';
import settings from '../config/settings';
import { footerLists, footerSocials } from '../config/footer';


export interface Props {
	seo?: BaseHeadProps;
}

import { nav } from '../config/nav.js';

const { seo } = Astro.props as Props;
---

<Layout seo={seo}>
	<AnnouncementBar
		slot="announcement-bar"
		text="14.5995° N — 120.9842° E · Street Wear · Manila · Orders Open"
		href="/products"
	/>
	<Header rightMenu navData={nav} slot="header">
		<span slot="logo">
			<Logo />
		</span>
		<Button slot="action-item" href="/products">Shop Now</Button>
	</Header>
	<div id="page">
		<slot />
	</div>
	<CartDrawer />
	<script>
		import '../scripts/cart.js';
	</script>
	<Footer
		slot="footer"
		footerLists={footerLists}
		footerSocials={footerSocials}
		copyrightName={settings.name}
		showPlug={settings.showPlug}
	>
		<Logo slot="logo" />
	</Footer>
</Layout>
