---
import Layout from '../../layouts/Page.astro';
import { products } from '../../data/products.js';

export function getStaticPaths() {
	return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const others = products.filter((p) => p.slug !== product.slug).slice(0, 3);
const isTee = product.category === 'shirts';

const seo = {
	title: `${product.name} | Kalye Noir`,
	description: product.blurb,
	image: product.img,
};
---

<Layout {seo}>
	<article class="detail">
		<div class="kn-wrap">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/products">Shop</a>
				<span aria-hidden="true">/</span>
				<a href={`/products#${product.category}`}>Shirts</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{product.short}</span>
			</nav>

			<div class="detail__grid">
				<figure class="detail__plate">
					<img src={product.img} alt={product.alt} width="800" height="600" />
				</figure>

				<div class="detail__panel">
					<p class="kn-label">{product.meta}</p>
					<h1 class="detail__title">{product.name}</h1>
					<p class="detail__blurb">{product.blurb}</p>

					<div class="field">
						<span class="field__label kn-label">
							{isTee ? 'Size' : 'Variant'}
						</span>
						<div class="sizes" role="radiogroup" aria-label={isTee ? 'Select size' : 'Variant'}>
							{
								product.sizes.map((s, i) => (
									<button
										type="button"
										class="size"
										data-size={s}
										role="radio"
										aria-checked={i === 0 ? 'true' : 'false'}
										data-selected={i === 0 ? 'true' : 'false'}
									>
										{s}
									</button>
								))
							}
						</div>
					</div>

					<div class="field">
						<span class="field__label kn-label">Quantity</span>
						<div class="qty">
							<button type="button" data-step="-1" aria-label="Decrease quantity">−</button>
							<span data-qty-value>1</span>
							<button type="button" data-step="1" aria-label="Increase quantity">+</button>
						</div>
					</div>

					<button
						class="add-to-cart detail__add"
						type="button"
						data-add
						data-id={product.id}
						data-name={product.name}
						data-img={product.img}
					>
						Add to cart
					</button>

					<p class="detail__note">
						Pricing confirmed per order. Add your pieces, then send the
						order request — we follow up with sizes, price and payment
						details.
					</p>

					<ul class="detail__specs">
						<li>Made to order · Manila</li>
						<li>{isTee ? 'Oversized fit · Front & back print' : 'Custom colours, patch & cord on request'}</li>
						<li>Custom requests welcome in the order note</li>
					</ul>
				</div>
			</div>
		</div>
	</article>

	<!-- ============ MORE FROM THE LINE ============ -->
	<section class="more" aria-labelledby="more-title">
		<div class="kn-wrap">
			<div class="more__head">
				<h2 id="more-title">More from the line</h2>
				<a class="more__all" href="/products">See all products →</a>
			</div>
			<ul class="cards">
				{
					others.map((p) => (
						<li class="card">
							<a class="card__link" href={`/products/${p.slug}`}>
								<figure class="card__plate">
									<img src={p.img} alt={p.alt} loading="lazy" decoding="async" />
								</figure>
								<div class="card__body">
									<p class="kn-label">{p.meta}</p>
									<h3 class="card__name">{p.short}</h3>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>

<style>
	.detail {
		padding-block: clamp(1.5rem, 4vw, 2.5rem) 0;
	}
	.crumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		font-family: var(--theme-font-mono);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--kn-ink-muted);
		margin-bottom: clamp(1.25rem, 3vw, 2rem);
	}
	.crumbs a {
		text-decoration: none;
	}
	.crumbs a:hover {
		color: var(--kn-red);
	}
	.crumbs span[aria-hidden] {
		color: var(--kn-red);
	}
	.crumbs [aria-current] {
		color: var(--kn-ink);
	}

	.detail__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: start;
	}
	.detail__plate {
		margin: 0;
		aspect-ratio: 4 / 3;
		background: var(--kn-paper-2);
		border: 1.5px solid var(--kn-ink);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}
	.detail__plate img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		mix-blend-mode: multiply;
	}
	.detail__title {
		font-size: clamp(2.2rem, 5vw, 3.75rem);
		line-height: 0.95;
		margin: 0.5rem 0 1rem;
	}
	.detail__blurb {
		max-width: 46ch;
		margin-bottom: 1.75rem;
	}

	.field {
		display: grid;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}
	.field__label {
		color: var(--kn-ink);
	}
	.sizes {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.size {
		min-width: 3rem;
		padding: 0.6rem 0.85rem;
		background: transparent;
		border: 2px solid var(--kn-ink);
		color: var(--kn-ink);
		font-family: var(--theme-font-mono);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.size:hover {
		background: color-mix(in srgb, var(--kn-ink) 10%, transparent);
	}
	.size[data-selected='true'] {
		background: var(--kn-ink);
		color: var(--kn-paper);
	}

	.qty {
		display: inline-flex;
		align-items: center;
		border: 2px solid var(--kn-ink);
	}
	.qty button {
		width: 2.75rem;
		height: 2.75rem;
		background: transparent;
		border: none;
		color: var(--kn-ink);
		font-size: 1.2rem;
		cursor: pointer;
		line-height: 1;
	}
	.qty button:hover {
		background: var(--kn-ink);
		color: var(--kn-paper);
	}
	.qty span {
		min-width: 2.75rem;
		text-align: center;
		font-family: var(--theme-font-mono);
	}

	.detail__add {
		width: 100%;
		padding: 1rem 1.25rem;
		font-size: var(--font-size-base);
	}
	.detail__note {
		font-family: var(--theme-font-mono);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		line-height: 1.7;
		color: var(--kn-ink-muted);
		margin: 1rem 0 1.5rem;
	}
	.detail__specs {
		margin: 0;
		padding: 1.25rem 0 0;
		border-top: 2px solid var(--kn-ink);
		list-style: none;
		display: grid;
		gap: 0.5rem;
	}
	.detail__specs li {
		font-size: var(--font-size-sm);
	}
	.detail__specs li::before {
		content: '// ';
		color: var(--kn-red);
		font-family: var(--theme-font-mono);
	}

	/* more */
	.more {
		margin-top: var(--section-margin);
	}
	.more__head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1.25rem;
		border-bottom: 2px solid var(--kn-ink);
		margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}
	.more__head h2 {
		font-size: clamp(2rem, 5vw, 3.5rem);
		margin: 0;
	}
	.more__all {
		font-family: var(--theme-font-mono);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.16em;
		text-decoration: none;
		border-bottom: 2px solid var(--kn-ink);
		padding-bottom: 2px;
	}
	.more__all:hover {
		color: var(--kn-red);
		border-color: var(--kn-red);
	}
	.cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--theme-grid-gap);
	}
	.card__link {
		display: block;
		text-decoration: none;
	}
	.card__plate {
		margin: 0 0 0.85rem;
		aspect-ratio: 4 / 3;
		background: var(--kn-paper-2);
		border: 1.5px solid var(--kn-ink);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}
	.card__plate img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		mix-blend-mode: multiply;
		transition: transform 0.5s var(--theme-hover-ease);
	}
	.card__link:hover .card__plate img {
		transform: scale(1.04);
	}
	.card__body {
		display: grid;
		gap: 0.25rem;
	}
	.card__name {
		margin: 0;
		font-size: var(--font-size-md);
	}
	.card__link:hover .card__name {
		color: var(--kn-red);
	}

	@media (max-width: 860px) {
		.detail__grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const root = document.querySelector('[data-add]');
	if (root) {
		const wrap = root.closest('article');
		let qty = 1;

		wrap.querySelectorAll('[data-size]').forEach((btn) => {
			btn.addEventListener('click', () => {
				wrap.querySelectorAll('[data-size]').forEach((b) => {
					b.dataset.selected = 'false';
					b.setAttribute('aria-checked', 'false');
				});
				btn.dataset.selected = 'true';
				btn.setAttribute('aria-checked', 'true');
			});
		});

		wrap.querySelectorAll('[data-step]').forEach((btn) => {
			btn.addEventListener('click', () => {
				qty = Math.max(1, qty + Number(btn.dataset.step));
				wrap.querySelector('[data-qty-value]').textContent = String(qty);
			});
		});

		root.addEventListener('click', () => {
			const sizeEl = wrap.querySelector('[data-size][data-selected="true"]');
			// cart.js is loaded globally from Page.astro; use its API so state stays single-source
			window.KN?.addToCart({
				id: root.dataset.id,
				name: root.dataset.name || '',
				size: sizeEl?.dataset.size ?? 'Custom',
				qty,
				img: root.dataset.img || '',
			});
			root.classList.add('is-added');
			const original = root.textContent;
			root.textContent = 'Added ✓';
			document.dispatchEvent(new CustomEvent('kn-add'));
			setTimeout(() => {
				root.classList.remove('is-added');
				root.textContent = original;
			}, 1400);
		});
	}
</script>
