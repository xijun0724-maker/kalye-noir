---
import MainLayout from '../../layouts/MainLayout.astro';
import AddToCartForm from '../../components/AddToCartForm.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { products } from '../../data/catalog';
import { courier } from '../../data/shipping';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const related = products.filter((p) => p.category === product.category && p.slug !== product.slug);
const other = products.filter((p) => p.category !== product.category);
const suggestions = [...related, ...other].slice(0, 4);
---

<style>
  [data-zoom] {
    /* Capped by the asset: 800×1000 is only ~1.33× dense at desktop width. */
    --zoom: 1.6;
  }
  [data-zoom] img {
    transition: transform 300ms ease-out;
  }
  [data-zoom][data-zoomed] img {
    transform: scale(var(--zoom));
    transform-origin: var(--zoom-x, 50%) var(--zoom-y, 50%);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-zoom] img {
      transition: none;
    }
  }
</style>

<MainLayout title={`${product.title} — KALYE NOIR`} description={product.blurb} image={product.image}>
  <nav class="wrap py-6 text-xs uppercase tracking-[0.18em] text-muted" aria-label="Breadcrumb">
    <a href="/products" class="hover:text-ink">Shop</a>
    <span class="mx-2">/</span>
    <span class="text-ink">{product.title}</span>
  </nav>

  <section class="wrap grid gap-10 pb-16 md:grid-cols-2">
    <div class="overflow-hidden bg-line/40" data-zoom>
      <img
        src={product.image}
        alt={product.alt}
        width="800"
        height="1000"
        class="aspect-[4/5] w-full object-contain"
      />
    </div>

    <div class="md:pt-6">
      <p class="label">Tees</p>
      <h1 class="mt-3 text-3xl display sm:text-4xl">{product.title}</h1>
      <p class="mt-5 max-w-prose text-muted">{product.blurb}</p>

      <div class="mt-8">
        <AddToCartForm product={product} />
      </div>

      <ul class="mt-8 space-y-2 border-t border-line pt-6 text-sm text-muted">
        <li>Shipping via {courier} — estimated in your cart</li>
        <li>Ships in 1–3 business days after payment is confirmed</li>
        <li>7-day easy returns on unworn items</li>
      </ul>
    </div>
  </section>

  {
    suggestions.length > 0 && (
      <section class="border-t border-line">
        <div class="wrap pt-12">
          <h2 class="text-xl font-semibold">You may also like</h2>
        </div>
        <ProductGrid products={suggestions} />
      </section>
    )
  }
</MainLayout>

<script>
  import { zoomOrigin } from '../../lib/zoom';

  // Origin follows the pointer so the back print can be read, instead of a fixed
  // centre crop. Mouse and pen only: hover means nothing on touch, where the
  // browser's own pinch-zoom already covers inspection.
  document.querySelectorAll<HTMLElement>('[data-zoom]').forEach((frame) => {
    const track = (event: PointerEvent) => {
      if (event.pointerType === 'touch') return;
      const { x, y } = zoomOrigin(frame.getBoundingClientRect(), event.clientX, event.clientY);
      frame.style.setProperty('--zoom-x', `${x}%`);
      frame.style.setProperty('--zoom-y', `${y}%`);
      frame.dataset.zoomed = '';
    };

    frame.addEventListener('pointermove', track);
    frame.addEventListener('pointerleave', () => delete frame.dataset.zoomed);
  });
</script>
