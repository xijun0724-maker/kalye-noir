		</div>
	</section>
</MainLayout>

<script>
	import { zoomOrigin } from '../../lib/zoom';

	// Thumbnail Switcher Logic (Matches Laureti Page 1)
	const thumbs = document.querySelectorAll<HTMLButtonElement>('[data-thumb]');
	const mainImg = document.getElementById('main-product-img') as HTMLImageElement;

	thumbs.forEach(thumb => {
		thumb.addEventListener('click', () => {
			thumbs.forEach(t => {
				t.classList.remove('border-2', 'border-ink');
				t.classList.add('border', 'border-plate');
			});
			thumb.classList.remove('border', 'border-plate');
			thumb.classList.add('border-2', 'border-ink');

			const newSrc = thumb.getAttribute('data-src');
			const newAlt = thumb.getAttribute('data-alt');
			if (mainImg && newSrc) {
				mainImg.style.opacity = '0.3';
				setTimeout(() => {
					mainImg.src = newSrc;
					if (newAlt) mainImg.alt = newAlt;
					if (thumb.getAttribute('data-thumb') === '0') {
						mainImg.className = 'aspect-[4/5] w-full object-contain transition-opacity duration-200';
					} else {
						mainImg.className = 'aspect-[4/5] w-full object-cover transition-opacity duration-200';
					}
					mainImg.style.opacity = '1';
				}, 120);
			}
		});
	});

	// Zoom Logic for Main Image
	document.querySelectorAll<HTMLElement>('[data-zoom]').forEach(frame => {
		const track = (event: PointerEvent) => {
			if (event.pointerType === 'touch') return;
			const { x, y } = zoomOrigin(
				frame.getBoundingClientRect(),
				event.clientX,
				event.clientY,
			);
			frame.style.setProperty('--zoom-x', `${x}%`);
			frame.style.setProperty('--zoom-y', `${y}%`);
			frame.dataset.zoomed = '';
		};

		frame.addEventListener('pointermove', track);
		frame.addEventListener('pointerleave', () => delete frame.dataset.zoomed);
	});
</script>
