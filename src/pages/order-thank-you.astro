---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Request Received: KALYE NOIR">
  <section class="wrap flex flex-col items-center py-28 text-center">
    <div class="mb-6 flex h-16 w-16 items-center justify-center border border-dashed border-line">
      <span class="h-3 w-3 rotate-45 bg-registration" aria-hidden="true"></span>
    </div>
    <h1 class="display text-4xl sm:text-5xl lg:text-6xl">Slip Received</h1>
    <p class="mt-6 max-w-md text-sm leading-relaxed text-muted">
      Your request slip has been logged with the studio. A print confirmation and exact courier dispatch timing will reach your inbox shortly.
    </p>
    <a href="/products" class="btn btn-primary mt-8">Explore Batch 001</a>
  </section>
</MainLayout>

<script>
  import { clearCart } from '../stores/cartStore';
  // Only an order request empties the cart; an incident report must not.
  if (!new URLSearchParams(location.search).has('incident')) clearCart();
</script>
