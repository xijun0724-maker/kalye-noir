---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Thank you — KALYE NOIR">
  <section class="wrap flex flex-col items-center py-32 text-center">
    <p class="label">Message received</p>
    <h1 class="display mt-5 text-4xl sm:text-5xl">Thank you!</h1>
    <p class="mt-5 max-w-md text-muted">
      We've received your submission and will follow up by email shortly with the next steps.
    </p>
    <a href="/products" class="btn btn-primary mt-8">Back to the tees</a>
  </section>
</MainLayout>

<script>
  import { clearCart } from '../stores/cartStore';
  clearCart();
</script>
