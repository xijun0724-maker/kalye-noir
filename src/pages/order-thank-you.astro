---
import { Container, Button } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

const seo = {
	title: 'Order Received | Kalye Noir',
	description: 'Your Kalye Noir order request has been received. We will follow up with pricing, sizes and payment details.',
};
---

<Layout {seo}>
	<Container>
		<section class="thank-you__section">
			<h1>Order Received</h1>
			<p>
				Salamat! Your request landed. We'll follow up with pricing,
				sizes and payment details. — NASA kalye nangangarap.
			</p>
			<Button href="/">Back to Shop</Button>
		</section>
	</Container>
</Layout>

<style>
	.thank-you__section {
		margin: var(--section-margin) auto;
		max-width: 40rem;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		min-height: 50vh;
	}
</style>
