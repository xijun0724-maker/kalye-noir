---
import Layout from '../layouts/Page.astro';
import { categories, productsByCategory } from '../data/products.js';

const seo = {
	title: 'Shop | Kalye Noir',
	description:
		'Shop Kalye Noir — MEDUSA, MAYNILA and KALYENOIR oversized tees, plus the GOOD THINGS INSIDE trinket pouch. Small-batch from Manila.',
};
---

<Layout {seo}>
	<!-- ============ CATALOGUE MASTHEAD ============ -->
	<header class="shop-head">
		<div class="kn-wrap">
			<p class="kn-label">The drop · 3 shirts + 1 pouch</p>
			<h1 class="shop-head__title">Shop the line</h1>
			<div class="kn-rule shop-head__rule"></div>
			<p class="shop-head__intro">
				Three oversized designs off the brand book — MEDUSA, MAYNILA,
				KALYENOIR — plus the customizable GOOD THINGS INSIDE pouch.
				Small-batch from Manila. Pricing confirmed per order.
			</p>
		</div>
	</header>

	<!-- ============ COLLECTION NAV ============ -->
	<nav class="collections kn-wrap" aria-label="Collections">
		<a href="#shirts">Shirts</a>
		<span aria-hidden="true">·</span>
		<a href="#pouch">Pouch</a>
	</nav>

	<!-- ============ COLLECTIONS ============ -->
	{
		categories.map((cat) => (
			<section id={cat.id} class="collection" aria-labelledby={`${cat.id}-title`}>
				<div class="kn-wrap">
					<div class="collection__head">
						<h2 id={`${cat.id}-title`}>{cat.title}</h2>
						<p class="kn-label">{cat.blurb}</p>
					</div>
					<ul class="cards">
						{productsByCategory(cat.id).map((p) => (
							<li class="card">
								<a class="card__link" href={`/products/${p.slug}`}>
									<figure class="card__plate">
										<img src={p.img} alt={p.alt} loading="lazy" decoding="async" />
									</figure>
									<div class="card__body">
										<p class="kn-label">{p.meta}</p>
										<h3 class="card__name">{p.name}</h3>
										<p class="card__price">Pricing confirmed per order</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		))
	}
</Layout>

<style>
	.shop-head {
		padding-block: clamp(2.5rem, 7vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
	}
	.shop-head__title {
		font-size: clamp(3rem, 11vw, 9rem);
		line-height: 0.85;
		letter-spacing: -0.02em;
		margin: 0.75rem 0 1.5rem;
	}
	.shop-head__rule {
		max-width: 14rem;
		margin-bottom: 1.5rem;
	}
	.shop-head__intro {
		max-width: 52ch;
		font-size: var(--font-size-md);
	}

	.collections {
		position: sticky;
		top: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding-block: 0.85rem;
		background: var(--kn-paper);
		border-bottom: 2px solid var(--kn-ink);
	}
	.collections a {
		font-family: var(--theme-font-mono);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.16em;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		padding-bottom: 2px;
	}
	.collections a:hover {
		border-color: var(--kn-red);
		color: var(--kn-red);
	}
	.collections span {
		color: var(--kn-red);
	}

	.collection {
		margin-top: var(--section-margin);
	}
	.collection__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		padding-bottom: 1rem;
		border-bottom: 2px solid var(--kn-ink);
		margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}
	.collection__head h2 {
		font-size: clamp(2.2rem, 6vw, 4.25rem);
		margin: 0;
	}
	.collection__head .kn-label {
		margin: 0;
	}

	.cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: clamp(1.25rem, 2.5vw, 2rem);
	}
	.card__link {
		display: block;
		text-decoration: none;
	}
	.card__plate {
		position: relative;
		margin: 0 0 0.9rem;
		aspect-ratio: 4 / 3;
		background: var(--kn-paper-2);
		border: 1.5px solid var(--kn-ink);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}
	.card__plate img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		mix-blend-mode: multiply;
		transition: transform 0.5s var(--theme-hover-ease);
	}
	.card__link:hover .card__plate img {
		transform: scale(1.04);
	}
	.card__body {
		display: grid;
		gap: 0.3rem;
	}
	.card__name {
		margin: 0;
		font-size: var(--font-size-md);
	}
	.card__price {
		margin: 0;
		font-family: var(--theme-font-mono);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--kn-ink-muted);
	}
	.card__link:hover .card__name {
		color: var(--kn-red);
	}
</style>
