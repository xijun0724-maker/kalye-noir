---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Plate Not Found (404): KALYE NOIR">
	<section class="wrap flex flex-col items-center py-28 text-center">
		<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-lg border border-hairline bg-paper shadow-xs">
			<span class="font-sans text-xl font-bold tracking-normal text-navy">
				404
			</span>
		</div>
		<h1 class="display text-4xl sm:text-5xl lg:text-6xl">Plate not found</h1>
		<p class="mt-6 max-w-md text-sm leading-relaxed text-ink/70">
			The pressing you're looking for was either pulled or never struck. The
			Batch 001 collection is still on the rack.
		</p>
		<a href="/products" class="btn btn-primary mt-8">
			Browse batch 001
		</a>
	</section>
</MainLayout>
