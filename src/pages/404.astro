---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Page not found — KALYE NOIR">
  <section class="wrap flex flex-col items-center py-32 text-center">
    <h1 class="display text-5xl sm:text-6xl">Page not found</h1>
    <p class="mt-6 max-w-md text-muted">
      The page you're looking for moved or never existed. The tees are all still here.
    </p>
    <a href="/products" class="btn btn-primary mt-8">Shop now</a>
  </section>
</MainLayout>
