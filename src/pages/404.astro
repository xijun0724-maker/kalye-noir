---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Plate Not Found (404) — KALYE NOIR">
  <section class="wrap flex flex-col items-center py-28 text-center">
    <div class="mb-6 flex h-16 w-16 items-center justify-center border border-dashed border-line">
      <span class="font-condensed text-xl font-bold tracking-widest text-registration">404</span>
    </div>
    <h1 class="display text-4xl sm:text-5xl lg:text-6xl">Plate Not Found</h1>
    <p class="mt-6 max-w-md text-sm leading-relaxed text-muted">
      The pressing you're looking for was either pulled or never struck. The Batch 001 collection is still on the rack.
    </p>
    <a href="/products" class="btn btn-primary mt-8">Explore The Collection</a>
  </section>
</MainLayout>
