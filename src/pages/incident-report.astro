---
import MainLayout from '../layouts/MainLayout.astro';

const field =
	'w-full min-w-0 rounded-none border border-plate bg-transparent px-4 py-3 text-base transition-colors placeholder:text-navy focus:border-ink sm:text-sm';
---

<MainLayout
	title="Incident Report · KALYE NOIR Order Claims"
	description="Report a missing, damaged or incorrect item from your Kalye Noir order. Attach photos and your order slip so we can settle the claim quickly."
>
	<div class="wrap pt-7">
		<nav
			class="meta flex items-center gap-2 text-navy"
			aria-label="Breadcrumb"
		>
			<a href="/" class="transition-colors hover:text-navy">
				Home
			</a>
			<span aria-hidden="true">/</span>
			<a href="/contact" class="transition-colors hover:text-navy">
				Contact Us
			</a>
			<span aria-hidden="true">/</span>
			<span class="text-ink">Incident report</span>
		</nav>
	</div>

	<section class="wrap py-12">
		<h1 class="display reveal text-center text-4xl sm:text-5xl">
			Incident report
		</h1>
		<p class="meta mx-auto mt-4 max-w-xl text-center text-navy">
			Official claim slip for missing, damaged, or incorrect items.
		</p>

		<form
			name="incident-report"
			method="POST"
			data-netlify="true"
			enctype="multipart/form-data"
			action="/contact?incident=1"
			class="mx-auto mt-12 grid max-w-3xl gap-5 rounded-lg border border-hairline bg-paper p-6 sm:p-9 shadow-xs"
		>
			<input type="hidden" name="form-name" value="incident-report" />

			<div class="grid gap-4 sm:grid-cols-2">
				<label class="grid gap-1.5">
					<span class="label">First name*</span>
					<input
						type="text"
						name="first-name"
						autocomplete="given-name"
						required
						class={field}
					/>
				</label>
				<label class="grid gap-1.5">
					<span class="label">Last name*</span>
					<input
						type="text"
						name="last-name"
						autocomplete="family-name"
						required
						class={field}
					/>
				</label>
			</div>

			<label class="grid gap-1.5">
				<span class="label">Facebook name*</span>
				<input type="text" name="facebook-name" required class={field} />
			</label>

			<div class="grid gap-4 sm:grid-cols-2">
				<label class="grid gap-1.5">
					<span class="label">Date today*</span>
					<input type="date" name="date-today" required class={field} />
				</label>
				<label class="grid gap-1.5">
					<span class="label">Date item / package was received*</span>
					<input type="date" name="date-received" required class={field} />
				</label>
			</div>

			<label class="grid gap-1.5">
				<span class="label">Invoice or order slip number*</span>
				<input type="text" name="order-slip" required class={field} />
			</label>

			<label class="grid gap-1.5">
				<span class="label">Email address*</span>
				<input
					type="email"
					name="email"
					autocomplete="email"
					required
					class={field}
				/>
			</label>

			<label class="grid max-w-xs gap-1.5">
				<span class="label">Contact number*</span>
				<input
					type="tel"
					name="contact-number"
					autocomplete="tel"
					required
					placeholder="09XX XXX XXXX"
					class={field}
				/>
			</label>

			<div class="mt-2">
				<p id="reason-label" class="text-sm font-bold">
					Reason for complaint or return
				</p>
				<p class="mt-2 text-sm leading-relaxed text-ink/70">
					(To simplify and speed up your concern, describe in detail the nature
					of complaint.)*
				</p>
				<textarea
					name="reason"
					rows="4"
					required
					aria-labelledby="reason-label"
					class={`${field} mt-3`}
				></textarea>
			</div>

			<div class="max-w-sm space-y-3 border-y border-dashed border-hairline py-5 text-sm leading-relaxed text-ink/70">
				<p>
					Note: change of color and/or size is allowed but subject to applicable
					shipping fees shouldered by the Buyer. We may replace your item with
					the condition that the item is in its original packaging with tag,
					unworn, and unused.
				</p>
				<p>
					Please attach photos to support your claims. (Acceptable file type:
					JPEG, JPG, PNG, GIF & PDF; up to 10mb file size)
				</p>
				<p class="font-bold text-ink">
					Our team will ask you to send via email an unboxing video for claims
					of missing or damaged item/s
				</p>
			</div>

			<label class="grid gap-1.5">
				<span class="label">Attach a file*</span>
				<input
					type="file"
					name="attachment"
					required
					multiple
					accept=".jpg,.jpeg,.png,.gif,.pdf"
					class="w-full min-w-0 rounded-md border border-plate bg-paper px-4 py-3 text-sm transition-colors file:mr-4 file:rounded-full file:border file:border-hairline file:bg-paper file:px-3 file:py-1.5 file:text-sm hover:file:bg-hairline/40 focus:border-ink"
				/>
			</label>

			<button type="submit" class="btn btn-primary mt-2 w-full">
				Submit
			</button>
		</form>
	</section>
</MainLayout>

<script>
	const form = document.querySelector<HTMLFormElement>(
		'form[name="incident-report"]',
	);
	let firstInvalidEl:
		(HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) | null = null;

	function getErrorMessage(
		el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
	): string {
		if (el.validity.valueMissing) {
			if (el.name === 'first-name') return 'First name required';
			if (el.name === 'last-name') return 'Last name required';
			if (el.name === 'facebook-name') return 'Facebook profile name required';
			if (el.name === 'date-today') return 'Current date required';
			if (el.name === 'date-received') return 'Delivery receipt date required';
			if (el.name === 'order-slip') return 'Order slip number required';
			if (el.name === 'email') return 'Email address required';
			if (el.name === 'contact-number') return 'Contact phone required';
			if (el.name === 'reason') return 'Detailed reason required';
			if (el.name === 'attachment') return 'Supporting photo/file required';
			return 'This field is required';
		}
		if (el.validity.typeMismatch && el.type === 'email') {
			return 'Valid email required (e.g. you@example.com)';
		}
		return el.validationMessage || 'Invalid input';
	}

	function showError(
		el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
	) {
		el.classList.add('!border-2', '!border-ink', '!bg-accent/25');
		el.setAttribute('aria-invalid', 'true');
		const parent = el.closest('label') || el.parentElement;
		if (!parent) return;

		let err = parent.querySelector<HTMLElement>('[data-error-msg]');
		const msg = getErrorMessage(el);
		const errorId = `${el.name || 'field'}-error`;

		if (!err) {
			err = document.createElement('p');
			err.setAttribute('data-error-msg', '');
			err.id = errorId;
			err.className =
				'field-error mt-1 flex items-center gap-1.5 text-sm font-bold text-ink';
			parent.appendChild(err);
		}
		err.innerHTML = `<span aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" class="shrink-0" aria-hidden="true"><path fill="currentColor" d="M12 2 1 21h22L12 2zm0 5.6 7.4 12.4H4.6L12 7.6zM11 10h2v5h-2zm0 6h2v2h-2z"/></svg></span> ${msg}`;
		el.setAttribute('aria-describedby', errorId);
	}

	function clearError(
		el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
	) {
		el.classList.remove('!border-2', '!border-ink', '!bg-accent/25');
		el.removeAttribute('aria-invalid');
		const parent = el.closest('label') || el.parentElement;
		const err = parent?.querySelector('[data-error-msg]');
		if (err) {
			err.remove();
		}
		el.removeAttribute('aria-describedby');
	}

	form
		?.querySelectorAll<
			HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
		>('input, select, textarea')
		.forEach(el => {
			el.addEventListener('invalid', e => {
				e.preventDefault();
				showError(el);
				if (!firstInvalidEl) {
					firstInvalidEl = el;
				}
			});
			el.addEventListener('input', () => {
				if (el.validity.valid) {
					clearError(el);
				}
			});
			el.addEventListener('change', () => {
				if (el.validity.valid) {
					clearError(el);
				}
			});
		});

	form?.addEventListener('submit', e => {
		firstInvalidEl = null;
		if (!form.checkValidity()) {
			e.preventDefault();
			setTimeout(() => {
				firstInvalidEl?.focus();
			}, 10);
		}
	});
</script>
