---
import MainLayout from '../layouts/MainLayout.astro';
import ProvinceSelect from '../components/ProvinceSelect.astro';
import { courier } from '../data/shipping';
import { ITEM_PRICE } from '../data/catalog';
---

<MainLayout
  title="Cart — KALYE NOIR Street Wear Manila"
  description="Review your Kalye Noir cart, add an order note, pick your province and estimate delivery before you send your order request."
>
  <div class="wrap pt-7">
    <nav class="meta flex items-center gap-2 text-muted" aria-label="Breadcrumb">
      <a href="/" class="transition-colors hover:text-registration">Home</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink">Cart</span>
    </nav>
  </div>

  <section class="wrap py-12">
    <h1 class="display reveal text-center text-4xl sm:text-5xl">Cart</h1>

    <div class="mt-14">
      <div
        class="meta hidden border-b border-line pb-3 text-muted sm:flex sm:items-center sm:justify-between"
      >
        <span>Product</span>
        <span>Quantity</span>
      </div>
      <div data-cart-rows></div>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <div>
        <label class="label mb-3 block" for="order-note">Add order note</label>
        <textarea
          id="order-note"
          data-order-note
          rows="5"
          placeholder="How can we help you?"
          class="w-full border border-line bg-transparent px-4 py-3 text-sm transition-colors placeholder:text-muted focus:border-registration focus:outline-none focus:ring-1 focus:ring-registration"
        ></textarea>
      </div>

      <div class="flex flex-col items-start gap-3 lg:items-end">
        <div class="flex flex-col items-start gap-1 lg:items-end">
          <p class="meta text-muted" aria-live="polite" aria-atomic="true">
            Items (<span data-cart-count-text>0</span>
            <span data-cart-count-word>items</span>)
          </p>
          <p class="font-display text-2xl text-ink" data-cart-subtotal>₱0</p>
        </div>
        <p class="meta text-ink lg:text-right">
          Estimated delivery: <span data-cart-shipping>Select a province below</span>
        </p>
        <p class="meta text-muted lg:text-right">
          Shipping via {courier}
        </p>
        <p class="text-xs leading-relaxed text-muted lg:text-right">
          Standard pricing: ₱{ITEM_PRICE} per print. Cash On Delivery (COD) and GCash / Maya QR accepted at checkout.
        </p>
        <a href="/checkout" class="btn btn-primary w-full sm:w-auto" data-checkout>Checkout</a>
      </div>
    </div>
  </section>

  <section class="wrap pb-20">
    <fieldset class="relative border border-line px-6 pb-6 pt-0">
      <legend class="meta mx-auto px-4 text-ink">Estimate delivery</legend>

      <label class="block">
        <span class="meta mb-1.5 block text-muted">Province</span>
        <ProvinceSelect class="w-full border border-line bg-transparent px-3 py-2.5 text-sm focus:border-registration focus:outline-none focus:ring-1 focus:ring-registration" />
      </label>

      <p data-estimate-result class="meta mt-5 text-muted" aria-live="polite"></p>
    </fieldset>
  </section>
</MainLayout>

<script>
  import {
    cartItems,
    cartCount,
    removeFromCart,
    stepQty,
    orderNote,
    shippingZoneId,
    shippingProvince,
  } from '../stores/cartStore';
  import type { CartItem } from '../stores/cartStore';
  import { zoneById } from '../data/shipping';
  import { ITEM_PRICE } from '../data/catalog';
  import { productArt } from '../data/productArt';

  const rows = document.querySelector<HTMLElement>('[data-cart-rows]');
  const countEl = document.querySelector<HTMLElement>('[data-cart-count-text]');
  const countWord = document.querySelector<HTMLElement>('[data-cart-count-word]');
  const subtotalEl = document.querySelector<HTMLElement>('[data-cart-subtotal]');
  const checkout = document.querySelector<HTMLAnchorElement>('[data-checkout]');
  const note = document.querySelector<HTMLTextAreaElement>('[data-order-note]');
  const shipEl = document.querySelector<HTMLElement>('[data-cart-shipping]');

  // Derived from the stored zone, so it never goes stale.
  function refreshShipping() {
    if (!shipEl) return;
    const zone = zoneById(shippingZoneId.get());
    shipEl.textContent = zone
      ? `${zone.label} · ${zone.days} business days`
      : 'Select a province below';
  }

  if (rows && countEl && countWord && checkout) {
    const line = (i: CartItem) => `
      <div data-sku="${i.sku}" class="grid grid-cols-[6rem_1fr] items-start gap-5 border-b border-line py-6 sm:grid-cols-[6rem_1fr_auto]">
        <img src="${productArt[i.slug]?.src ?? ''}" alt="" width="96" height="120" loading="lazy" class="h-[120px] w-24 bg-white object-contain p-2" />
        <div class="min-w-0">
          <p class="font-condensed text-[13px] font-semibold uppercase tracking-[0.12em]">${i.title}</p>
          <p class="font-condensed text-sm font-bold text-ink mt-1">₱${ITEM_PRICE}</p>
          <p class="meta mt-0.5 text-muted">${i.variant}</p>
        </div>
        <div class="col-span-2 flex flex-col items-start gap-2 sm:col-span-1 sm:items-end">
          <div class="flex items-stretch border border-line">
            <button type="button" data-step="-1" class="h-11 w-11 text-lg leading-none transition-colors hover:bg-line/40" aria-label="Decrease quantity"><span aria-hidden="true">−</span></button>
            <span class="flex w-12 items-center justify-center text-sm">${i.qty}</span>
            <button type="button" data-step="1" class="h-11 w-11 text-lg leading-none transition-colors hover:bg-line/40" aria-label="Increase quantity"><span aria-hidden="true">+</span></button>
          </div>
          <button type="button" data-remove class="meta text-muted underline underline-offset-4 transition-colors hover:text-registration">Remove</button>
        </div>
      </div>`;

    function render() {
      const items = cartItems.get();
      rows!.innerHTML = items.length
        ? items.map(line).join('')
        : `<div class="flex flex-col items-center justify-center border-b border-line py-16 text-center">
            <div class="relative mb-4 flex h-16 w-16 items-center justify-center border border-line bg-paper">
              <svg viewBox="0 0 24 24" width="28" height="28" class="text-muted" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0"/>
              </svg>
              <span class="absolute -right-1 -top-1 h-2 w-2 rotate-45 bg-registration"></span>
            </div>
            <p class="font-display text-2xl uppercase tracking-wider text-ink">Your Slip Is Empty</p>
            <p class="mt-2 text-xs text-muted max-w-xs">Pick a piece from Drop 001. Sizing and courier dispatch confirmed per request slip.</p>
            <a href="/products" class="btn btn-primary mt-6 text-xs px-6 py-2.5">Explore Drop 001</a>
          </div>`;

      const count = cartCount.get();
      const subtotal = count * ITEM_PRICE;
      countEl!.textContent = String(count);
      countWord!.textContent = count === 1 ? 'item' : 'items';
      if (subtotalEl) subtotalEl.textContent = `₱${subtotal.toLocaleString()}`;
      checkout!.classList.toggle('pointer-events-none', count === 0);
      checkout!.classList.toggle('opacity-40', count === 0);
      checkout!.setAttribute('aria-disabled', String(count === 0));
      refreshShipping();
    }

    rows.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const sku = t.closest<HTMLElement>('[data-sku]')?.dataset.sku;
      if (!sku) return;
      if (t.closest('[data-remove]')) return removeFromCart(sku);
      const step = t.closest<HTMLElement>('[data-step]');
      if (step) stepQty(sku, Number(step.dataset.step));
    });

    // pointer-events-none only stops the mouse; a link still activates on Enter.
    checkout.addEventListener('click', (e) => {
      if (!cartCount.get()) e.preventDefault();
    });

    cartItems.subscribe(render);
    render();
  }

  if (note) {
    note.value = orderNote.get();
    note.addEventListener('input', () => orderNote.set(note.value));
  }

  const province = document.querySelector<HTMLSelectElement>('[data-province]');
  const result = document.querySelector<HTMLElement>('[data-estimate-result]');

  if (province && result) {
    if (shippingProvince.get()) province.value = shippingProvince.get();

    province.addEventListener('change', () => {
      const zone = zoneById(province.selectedOptions[0]?.dataset.zone);
      shippingZoneId.set(zone?.id ?? '');
      shippingProvince.set(province.value);
      result.textContent = zone
        ? `Delivering to ${zone.label} in ${zone.days} business days.`
        : 'Choose a province to see the delivery estimate.';
      refreshShipping();
    });
  }
</script>
