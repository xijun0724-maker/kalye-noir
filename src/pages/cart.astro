---
import MainLayout from '../layouts/MainLayout.astro';
import { getImage } from 'astro:assets';
import { productArt } from '../data/productArt';
import { shippingZones } from '../data/shipping';

const thumbnails = Object.fromEntries(
	await Promise.all(
		Object.entries(productArt).map(async ([slug, image]) => {
			const thumbnail = await getImage({
				src: image,
				width: 192,
				format: 'webp',
				quality: 80,
			});
			return [slug, thumbnail.src];
		}),
	),
);
---

<MainLayout
	title="Cart · KALYE NOIR Manila"
	description="Review your Kalye Noir cart, estimate delivery to your Philippine province, and proceed to checkout."
>
	<section class="wrap py-12 sm:py-16 max-w-5xl mx-auto">
		<!-- Page Header: CART (Matches Laureti Image 3) -->
		<h1 class="font-title text-2xl sm:text-3xl uppercase tracking-[0.2em] text-center text-ink mb-10 sm:mb-14">
			CART
		</h1>

		<!-- Empty State -->
		<div data-cart-empty class="hidden py-20 text-center border-y border-hairline">
			<p class="font-title text-lg uppercase tracking-wider text-ink font-bold">
				Your cart is empty
			</p>
			<p class="text-xs text-navy mt-2">
				Explore Batch 001 pieces and add them to your cart.
			</p>
			<a href="/products" class="btn btn-primary mt-6 inline-block text-xs py-3 px-8 uppercase tracking-[0.2em]">
				Browse Collection
			</a>
		</div>

		<!-- Cart Content (Matches Laureti Image 3) -->
		<div data-cart-content>
			<!-- Table Header -->
			<div class="grid grid-cols-[1fr_auto_auto] items-center border-b border-hairline pb-3 text-xs uppercase tracking-wider text-navy font-title">
				<span>PRODUCT</span>
				<span class="w-32 text-center">QUANTITY</span>
				<span class="w-24 text-right">TOTAL</span>
			</div>

			<!-- Product Items Container -->
			<div
				data-cart-table-rows
				data-thumbnail-sources={JSON.stringify(thumbnails)}
				class="divide-y divide-hairline border-b border-hairline"
			>
				<!-- Populated via JavaScript -->
			</div>

			<!-- Middle Section: Note & Checkout Summary -->
			<div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
				<!-- Left: Add Order Note -->
				<div>
					<label for="cart-page-note" class="block font-title text-xs font-semibold uppercase tracking-wider text-ink mb-2">
						Add order note
					</label>
					<textarea
						id="cart-page-note"
						data-cart-page-note
						rows="4"
						placeholder="How can we help you?"
						class="w-full text-xs p-3.5 bg-white border border-plate/80 rounded-none text-ink placeholder:text-navy/50 focus:border-ink focus:outline-none"
					></textarea>
				</div>

				<!-- Right: Total and Checkout Button -->
				<div class="flex flex-col items-start md:items-end md:text-right space-y-2">
					<p class="font-sans text-base sm:text-lg font-bold text-ink">
						Total: <span data-cart-page-total>₱0.00</span>
					</p>
					<p class="text-xs text-navy/70">
						Taxes and shipping calculated at checkout
					</p>
					<div class="pt-2 w-full md:w-auto">
						<a
							href="/checkout"
							class="w-full md:w-48 bg-[#111110] hover:bg-black text-white text-xs font-title font-semibold uppercase tracking-[0.2em] py-3.5 transition-colors text-center block rounded-none shadow-xs"
						>
							CHECKOUT
						</a>
					</div>
				</div>
			</div>

			<!-- Bottom Section: ESTIMATE SHIPPING (Matches Laureti Image 3) -->
			<div class="mt-16 sm:mt-20">
				<!-- Centered Section Title with Dividers -->
				<div class="relative flex items-center justify-center mb-6">
					<div class="border-t border-hairline flex-grow"></div>
					<h2 class="font-title text-xs sm:text-sm uppercase tracking-[0.24em] text-navy px-4 font-semibold">
						ESTIMATE SHIPPING
					</h2>
					<div class="border-t border-hairline flex-grow"></div>
				</div>

				<!-- Estimate Shipping Box -->
				<div class="border border-plate/80 bg-paper/50 p-6 sm:p-8">
					<form data-shipping-calc-form class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
						<!-- Country -->
						<div>
							<label class="block font-title text-[11px] uppercase tracking-wider text-navy mb-1.5">
								Country
							</label>
							<select
								disabled
								class="w-full text-xs p-2.5 bg-white border border-plate/80 text-ink rounded-none cursor-not-allowed"
							>
								<option value="Philippines" selected>Philippines</option>
							</select>
						</div>

						<!-- Province -->
						<div>
							<label class="block font-title text-[11px] uppercase tracking-wider text-navy mb-1.5">
								Province
							</label>
							<select
								data-calc-province
								class="w-full text-xs p-2.5 bg-white border border-plate/80 text-ink rounded-none focus:border-ink focus:outline-none"
							>
								{shippingZones.flatMap(z =>
									z.provinces.map(p => (
										<option value={p} data-zone={z.id}>
											{p}
										</option>
									)),
								)}
							</select>
						</div>

						<!-- Zip Code -->
						<div>
							<label class="block font-title text-[11px] uppercase tracking-wider text-navy mb-1.5">
								Zip code
							</label>
							<input
								type="text"
								data-calc-zip
								placeholder="Zip code"
								class="w-full text-xs p-2.5 bg-white border border-plate/80 text-ink rounded-none focus:border-ink focus:outline-none"
							/>
						</div>

						<!-- Estimate Button -->
						<div>
							<button
								type="button"
								data-calc-submit
								class="w-full bg-[#111110] hover:bg-black text-white text-xs font-title font-semibold uppercase tracking-[0.18em] py-2.5 transition-colors text-center rounded-none cursor-pointer"
							>
								ESTIMATE
							</button>
						</div>
					</form>

					<!-- Estimate Result Feedback -->
					<div data-calc-result class="mt-4 hidden p-3 bg-white border border-hairline text-xs text-ink"></div>
				</div>
			</div>
		</div>
	</section>
</MainLayout>

<script>
	import {
		cartItems,
		removeFromCart,
		stepQty,
		orderNote,
		getCartItemPrice,
		cartSubtotal,
		shippingZoneId,
		shippingProvince,
	} from '../stores/cartStore';
	import { products } from '../data/catalog';
	import { zoneById, calculateShippingFee } from '../data/shipping';
	import { escapeHTML } from '../lib/escapeHTML';

	const content = document.querySelector<HTMLElement>('[data-cart-content]');
	const emptyState = document.querySelector<HTMLElement>('[data-cart-empty]');
	const rowsContainer = document.querySelector<HTMLElement>('[data-cart-table-rows]');
	const totalDisplay = document.querySelector<HTMLElement>('[data-cart-page-total]');
	const noteInput = document.querySelector<HTMLTextAreaElement>('[data-cart-page-note]');

	const provinceSelect = document.querySelector<HTMLSelectElement>('[data-calc-province]');
	const estimateBtn = document.querySelector<HTMLButtonElement>('[data-calc-submit]');
	const estimateResult = document.querySelector<HTMLElement>('[data-calc-result]');

	const rawThumbnails: unknown = JSON.parse(rowsContainer?.dataset.thumbnailSources ?? '{}');
	const thumbnailSources = new Map<string, string>(Object.entries(rawThumbnails as Record<string, string>));

	// Order note synchronization
	if (noteInput) {
		noteInput.value = orderNote.get();
		noteInput.addEventListener('input', () => orderNote.set(noteInput.value));
	}

	function renderTable() {
		if (!rowsContainer || !content || !emptyState) return;
		const items = cartItems.get();

		if (!items.length) {
			content.classList.add('hidden');
			emptyState.classList.remove('hidden');
			return;
		}

		content.classList.remove('hidden');
		emptyState.classList.add('hidden');

		rowsContainer.innerHTML = items
			.map(item => {
				const product = products.find(p => p.slug === item.slug);
				const title = product?.title ?? item.title;
				const image = thumbnailSources.get(item.slug) ?? '';
				const unitPrice = getCartItemPrice(item);
				const lineTotal = unitPrice * item.qty;

				const size = item.variant.includes('·')
					? item.variant.split('·').pop()?.trim().toUpperCase()
					: item.variant.toUpperCase();

				const fullSizeName: Record<string, string> = {
					XS: 'EXTRA SMALL',
					S: 'SMALL',
					M: 'MEDIUM',
					L: 'LARGE',
					XL: 'EXTRA LARGE',
					'2XL': '2 EXTRA LARGE',
				};
				const displaySize = (fullSizeName[size ?? ''] || size) ?? '';

				return `
					<div class="grid grid-cols-[1fr_auto_auto] items-center py-6 gap-4" data-sku="${escapeHTML(item.sku)}">
						<!-- Product Col -->
						<div class="flex items-center gap-4 min-w-0">
							<div class="h-20 w-16 sm:h-24 sm:w-20 bg-white border border-hairline shrink-0 p-1">
								<img
									src="${escapeHTML(image)}"
									alt="${escapeHTML(title)}"
									class="h-full w-full object-contain"
									loading="lazy"
								/>
							</div>
							<div class="min-w-0">
								<h3 class="font-title text-xs sm:text-sm font-semibold uppercase tracking-wider text-ink truncate">
									${escapeHTML(title)}
								</h3>
								<p class="font-sans text-xs text-navy mt-0.5">
									₱${unitPrice.toFixed(2)}
								</p>
								<p class="font-title text-[11px] uppercase tracking-wider text-navy/70 mt-0.5">
									${escapeHTML(displaySize)}
								</p>
							</div>
						</div>

						<!-- Quantity Col -->
						<div class="w-32 flex flex-col items-center justify-center">
							<div class="flex items-center justify-between border border-plate/80 w-24 h-8 px-2 bg-white text-ink text-xs">
								<button
									type="button"
									data-step="-1"
									class="text-sm text-navy hover:text-ink cursor-pointer leading-none p-1"
									aria-label="Decrease quantity"
								>
									−
								</button>
								<span class="font-title text-xs font-semibold text-ink">
									${item.qty}
								</span>
								<button
									type="button"
									data-step="1"
									class="text-sm text-navy hover:text-ink cursor-pointer leading-none p-1"
									aria-label="Increase quantity"
								>
									+
								</button>
							</div>
							<button
								type="button"
								data-remove
								class="text-xs text-navy hover:text-ink underline underline-offset-2 mt-2 cursor-pointer transition-colors"
							>
								Remove
							</button>
						</div>

						<!-- Total Col -->
						<div class="w-24 text-right">
							<span class="font-sans text-xs sm:text-sm font-bold text-ink">
								₱${lineTotal.toFixed(2)}
							</span>
						</div>
					</div>
				`;
			})
			.join('');

		const total = cartSubtotal(items);
		if (totalDisplay) totalDisplay.textContent = `₱${total.toFixed(2)}`;
	}

	// Delegated item events (stepper & remove)
	rowsContainer?.addEventListener('click', e => {
		const target = e.target as HTMLElement;
		const line = target.closest<HTMLElement>('[data-sku]');
		if (!line) return;
		const sku = line.dataset.sku!;

		if (target.closest('[data-remove]')) {
			removeFromCart(sku);
			return;
		}

		const stepBtn = target.closest<HTMLElement>('[data-step]');
		if (stepBtn) {
			stepQty(sku, Number(stepBtn.dataset.step));
		}
	});

	// Estimate shipping action
	estimateBtn?.addEventListener('click', () => {
		if (!provinceSelect || !estimateResult) return;
		const selectedOpt = provinceSelect.selectedOptions[0];
		const zoneId = selectedOpt?.dataset.zone;
		const province = provinceSelect.value;
		const zone = zoneById(zoneId);

		if (!zone) {
			estimateResult.classList.remove('hidden');
			estimateResult.textContent = 'Please choose a valid province.';
			return;
		}

		shippingZoneId.set(zone.id);
		shippingProvince.set(province);

		const items = cartItems.get();
		const count = items.reduce((sum, i) => sum + i.qty, 0);
		const fee = calculateShippingFee(zone.id, count);

		estimateResult.classList.remove('hidden');
		estimateResult.innerHTML = `
			<strong>${escapeHTML(zone.label)}:</strong> Delivered in <strong>${zone.days} business days</strong> via LBC Express.<br/>
			Estimated shipping fee: <strong>${fee === 0 ? 'FREE (3+ items promo)' : `₱${fee}.00`}</strong>.
		`;
	});

	cartItems.subscribe(renderTable);
	renderTable();
</script>
