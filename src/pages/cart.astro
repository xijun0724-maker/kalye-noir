				</label>
				<div class="grid gap-4 sm:grid-cols-2">
					<label class="grid gap-1.5">
						<span class="label">City / municipality</span>
						<input
							type="text"
							name="city"
							autocomplete="address-level2"
							required
							class="w-full min-w-0 border border-line-strong bg-transparent px-4 py-3 text-base transition-colors placeholder:text-muted focus:border-registration focus:outline-none focus:ring-1 focus:ring-registration sm:text-sm"
						/>
					</label>
					<label class="grid gap-1.5">
						<span class="label">Zip code</span>
						<input
							type="text"
							name="zip"
							autocomplete="postal-code"
							inputmode="numeric"
							required
							class="w-full min-w-0 border border-line-strong bg-transparent px-4 py-3 text-base transition-colors placeholder:text-muted focus:border-registration focus:outline-none focus:ring-1 focus:ring-registration sm:text-sm"
						/>
					</label>
				</div>
				<label class="grid gap-1.5 sm:col-span-2">
					<span class="label">Order note</span>
					<textarea
						name="note"
						rows="3"
						placeholder="How can we help you?"
						data-order-note
						class="w-full min-w-0 border border-line-strong bg-transparent px-4 py-3 text-base transition-colors placeholder:text-muted focus:border-registration focus:outline-none focus:ring-1 focus:ring-registration sm:text-sm"
					></textarea>
				</label>
			</div>

			<div class="pt-2">
				<p class="meta text-muted">Payment method</p>
				<fieldset
					class="mt-2 grid gap-3 sm:grid-cols-2"
					data-payment-selector
				>
					<legend class="sr-only">Choose a payment method</legend>
					<label class="flex cursor-pointer items-center justify-between border border-line-strong bg-paper p-4 transition-colors has-[:checked]:border-ink has-[:checked]:bg-white">
						<div class="flex items-center gap-3">
							<input
								type="radio"
								name="payment-type"
								value="cod"
								checked
								class="accent-registration"
							/>
							<div>
								<p class="font-condensed text-xs font-bold uppercase tracking-wider text-ink">
									Cash On Delivery (COD)
								</p>
								<p class="meta text-muted mt-0.5">
									Pay courier upon delivery
								</p>
							</div>
						</div>
						<span class="font-condensed text-xs font-semibold text-muted">
							COD
						</span>
					</label>

					<label class="flex cursor-pointer items-center justify-between border border-line-strong bg-paper p-4 transition-colors has-[:checked]:border-ink has-[:checked]:bg-white">
						<div class="flex items-center gap-3">
							<input
								type="radio"
								name="payment-type"
								value="gcash"
								aria-controls="manual-transfer-panel"
								class="accent-registration"
							/>
							<div>
								<p class="font-condensed text-xs font-bold uppercase tracking-wider text-ink">
									GCash / Maya transfer
								</p>
								<p class="meta text-muted mt-0.5">
									Manual transfer · Optional receipt
								</p>
							</div>
						</div>
						<span class="font-condensed text-xs font-semibold text-registration">
							MANUAL
						</span>
					</label>
				</fieldset>

				<div
					id="manual-transfer-panel"
					data-gcash-panel
					class="mt-3 hidden space-y-4 border border-line bg-paper p-5 sm:p-6"
				>
					<div class="flex flex-col sm:flex-row items-center gap-6">
						<div class="max-w-sm text-center sm:text-left">
							<span class="label">Manual transfer</span>
							<h2 class="mt-1 font-display text-xl uppercase tracking-wider text-ink">
								QR payment unavailable
							</h2>
							<p class="mt-2 text-xs leading-relaxed text-muted">
								No verified payment QR is available. If you choose GCash or
								Maya, transfer manually to the account below.
							</p>
						</div>
						<div class="space-y-1.5 text-center sm:text-left">
							<span class="label">Merchant payment account</span>
							<p class="font-display text-xl uppercase tracking-wider text-ink">
								${contact.name}
							</p>
							<p class="font-condensed text-base font-bold tracking-widest text-ink">
								${contact.mobile}
							</p>
							<p class="text-xs leading-relaxed text-muted">
								Transfer the exact total shown on this order slip. Enter your
								13-digit reference below; a receipt upload is optional.
							</p>
						</div>
					</div>

					<div class="grid gap-4 sm:grid-cols-2 pt-3 border-t border-line">
						<label class="grid gap-1.5">
							<span class="label">Reference No.*</span>
							<input
								type="text"
								name="payment-ref"
								data-payment-ref
								pattern="[0-9]{13}"
								title="13-digit transaction reference number"
								placeholder="13-digit Reference No."
								class="w-full min-w-0 border border-line-strong bg-transparent px-4 py-3 text-base transition-colors placeholder:text-muted focus:border-registration focus:outline-none focus:ring-1 focus:ring-registration sm:text-sm"
							/>
						</label>
						<label class="grid gap-1.5">
							<span class="label">Transfer Receipt Screenshot</span>
							<input
								type="file"
								name="payment-slip"
								data-payment-slip
								accept="image/jpeg,image/png,image/webp,application/pdf"
								aria-describedby="payment-slip-help"
								class="w-full min-w-0 border border-line-strong bg-transparent px-3 py-2 text-xs transition-colors file:mr-3 file:border file:border-line file:bg-white file:px-2.5 file:py-1 file:font-condensed file:text-xs file:uppercase file:tracking-wider hover:file:bg-line/40 focus:border-registration focus:outline-none"
							/>
							<span id="payment-slip-help" class="meta text-muted">
								Optional. JPG, PNG, WebP, or PDF · 4 MB maximum.
							</span>
						</label>
					</div>
				</div>
			</div>

			<div class="mt-4 space-y-4 border-y border-dashed border-muted/50 py-6 text-sm leading-relaxed text-muted">
				<p>${orderTerms.receipt}</p>
				<p>${orderTerms.preparation}</p>
				<div class="space-y-2">
					<p>${orderTerms.deliveryIntro}</p>
					<ul class="space-y-1">
						${deliveryLines.map(line => `<li>${line}</li>`).join('')}
					</ul>
				</div>
				<p
					class="border-t border-dashed border-muted/50 pt-4"
					data-terms-payment
				>
					${orderTerms.payment}
				</p>
			</div>

			<div
				data-checkout-error
				class="hidden border-2 border-registration bg-paper px-4 py-3 text-center font-condensed text-xs font-semibold text-ink"
				role="alert"
				aria-live="assertive"
				tabindex="-1"
			>
				<span
					class="inline-block font-bold text-registration mr-1.5"
					aria-hidden="true"
				>
					[!]
				</span>{' '}
				<span data-checkout-error-text>
					Your request slip is empty. Please select a print before submitting.
				</span>
			</div>
			<button
				type="submit"
				class="btn btn-primary w-full disabled:cursor-wait disabled:opacity-70"
			>
				Send Order Request
			</button>
		</form>
		`;

		// Initialize checkout form logic
		initCheckoutForm();
	}

	function initCheckoutForm() {
		const form = document.querySelector<HTMLFormElement>('[data-order-form]');
		if (!form) return;

		const itemsEl = document.querySelector<HTMLElement>(
			'[data-checkout-items]',
		);
		const countEl = document.querySelector<HTMLElement>(
			'[data-checkout-count]',
		);
		const subtotalEl = document.querySelector<HTMLElement>('[data-subtotal]');
		const shippingFeeEl = document.querySelector<HTMLElement>(
			'[data-shipping-fee-display]',
		);
		const grandTotalEl =
			document.querySelector<HTMLElement>('[data-grand-total]');
		const shippingBadge = document.querySelector<HTMLElement>(
			'[data-shipping-badge]',
		);
		const note =
			document.querySelector<HTMLTextAreaElement>('[data-order-note]');
		const windowEl = document.querySelector<HTMLElement>(
			'[data-delivery-window]',
		);
		const provinceSelect =
			form.querySelector<HTMLSelectElement>('[data-province]');
		const gcashPanel = form.querySelector<HTMLElement>('[data-gcash-panel]');
		const paymentRefInput =
			form.querySelector<HTMLInputElement>('[data-payment-ref]');
		const paymentSlipInput = form.querySelector<HTMLInputElement>(
			'[data-payment-slip]',
		);
		const paymentReassurance = document.querySelector<HTMLElement>(
			'[data-payment-reassurance]',
		);
		const termsPayment = form.querySelector<HTMLElement>(
			'[data-terms-payment]',
		);
		const errorMessage = form.querySelector<HTMLElement>(
			'[data-checkout-error-text]',
		);
		let isSubmitting = false;

		let currentZoneId = shippingZoneId.get();

		function updateTotals() {
			const count = cartCount.get();
			const subtotal = cartSubtotal(cartItems.get());
			const hasProvince = Boolean(provinceSelect?.value);
			const shippingFee =
				count && hasProvince ? calculateShippingFee(currentZoneId, count) : 0;
			const grandTotal = subtotal + shippingFee;

			if (subtotalEl) subtotalEl.textContent = `₱${subtotal.toLocaleString()}`;
			if (shippingFeeEl) {
				shippingFeeEl.textContent = !hasProvince
					? 'Pending'
					: count >= FREE_SHIPPING_THRESHOLD
						? 'FREE'
						: `₱${shippingFee}`;
			}
			if (grandTotalEl)
				grandTotalEl.textContent = `₱${grandTotal.toLocaleString()}`;

			if (shippingBadge) {
				if (!hasProvince) {
					shippingBadge.textContent = `${courier} dispatch · Select province for rate`;
				} else if (count >= FREE_SHIPPING_THRESHOLD) {
					shippingBadge.textContent = `${courier} dispatch · FREE DELIVERY (3+ prints)`;
				} else {
					shippingBadge.textContent = `${courier} dispatch · ₱${shippingFee} delivery`;
				}
			}
		}

		function refreshDelivery() {
			if (!windowEl || !provinceSelect) return;
			const zone = zoneById(provinceSelect.selectedOptions[0]?.dataset.zone);
			currentZoneId = zone?.id ?? '';
			if (!zone) {
				windowEl.textContent = 'Select your province';
				updateTotals();
				return;
			}
			windowEl.textContent = `${zone.label} · ${zone.days} business days`;
			updateTotals();
		}

		function updatePaymentState(method: string) {
			const isGCash = method === 'gcash';
			if (gcashPanel) gcashPanel.classList.toggle('hidden', !isGCash);
			if (paymentRefInput) paymentRefInput.required = isGCash;

			if (paymentReassurance) {
				paymentReassurance.textContent = isGCash
					? 'Transfer manually to the account shown above, then enter your 13-digit reference. Receipt upload is optional.'
					: 'Pay the exact grand total directly to the courier upon delivery.';
			}

			if (termsPayment) {
				termsPayment.textContent = isGCash
					? '* The studio will verify your GCash / Maya transfer before courier pick-up; this order email is not payment confirmation.'
					: '* Please prepare exact cash for the courier upon parcel delivery.';
			}
		}

		form
			?.querySelectorAll<HTMLInputElement>('input[name="payment-type"]')
			.forEach(radio => {
				radio.addEventListener('change', () => updatePaymentState(radio.value));
			});
		const selectedPayment = form?.querySelector<HTMLInputElement>(
			'input[name="payment-type"]:checked',
		);
		if (selectedPayment) updatePaymentState(selectedPayment.value);

		if (provinceSelect) {
			if (shippingProvince.get()) provinceSelect.value = shippingProvince.get();
			provinceSelect.addEventListener('change', () => {
				const zone = provinceSelect.selectedOptions[0]?.dataset.zone ?? '';
				shippingZoneId.set(zone);
				shippingProvince.set(provinceSelect.value);
				refreshDelivery();
			});
			refreshDelivery();
		}

		if (itemsEl && countEl) {
			const render = () => {
				const cart = cartItems.get();
				itemsEl.innerHTML = cart.length
					? cart
							.map(i => {
								const product = products.find(
									candidate => candidate.slug === i.slug,
								);
								const variant = product?.variants.find(
									candidate => candidate.sku === i.sku,
								);
								const title = product?.title ?? i.title;
								const size = variant
									? [variant.color, variant.size].filter(Boolean).join(' · ')
									: i.variant;
								return `
	          <div class="flex items-start justify-between gap-4 border-b border-line py-3 last:border-0">
	            <div class="min-w-0">
	              <p class="font-condensed text-[0.8125rem] font-semibold uppercase tracking-[0.12em]">${escapeHTML(title)}</p>
	              <p class="meta mt-1 text-muted">${escapeHTML(size)} · ₱${getCartItemPrice(i).toLocaleString()}</p>
	            </div>
	            <span class="text-sm font-semibold text-ink">×${i.qty}</span>
	          </div>`;
							})
							.join('')
					: `<div class="py-6 text-center">
	             <span class="inline-block h-2 w-2 rotate-45 bg-registration mb-2"></span>
	             <p class="font-condensed text-xs font-semibold uppercase tracking-wider text-ink">Your order slip is empty</p>
	             <p class="meta text-xs text-muted mt-1">Staged prints will appear here.</p>
	             <a href="/products" class="btn btn-primary mt-4 min-h-11 text-xs px-4 py-2">Select a print →</a>
	           </div>`;
				countEl.textContent = String(cartCount.get());
				refreshDelivery();
			};
			cartItems.subscribe(render);
			render();
		}

		if (note) {
			note.value = orderNote.get();
			note.addEventListener('input', () => orderNote.set(note.value));
		}

		const errBox = form?.querySelector<HTMLElement>('[data-checkout-error]');
		const submitBtn = form?.querySelector<HTMLButtonElement>(
			'button[type="submit"]',
		);
		const submitLabel = submitBtn?.textContent ?? '';
		const cartField = form?.querySelector<HTMLInputElement>(
			'input[name="cart-items"]',
		);

		function showCheckoutError(message: string) {
			if (errorMessage) errorMessage.textContent = message;
			errBox?.classList.remove('hidden');
			errBox?.focus();
		}

		function getErrorMessage(
			el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
		): string {
			if (el.validity.valueMissing) {
				if (el.name === 'name') return 'Full name required';
				if (el.name === 'email') return 'Email address required';
				if (el.name === 'phone') return 'Contact number required';
				if (el.name === 'street') return 'Street / barangay required';
				if (el.name === 'province') return 'Select your province';
				if (el.name === 'city') return 'City / municipality required';
				if (el.name === 'zip') return 'Zip code required';
				if (el.name === 'payment-ref')
					return '13-digit reference number required';
				return 'This field is required';
			}
			if (el.validity.typeMismatch && el.type === 'email') {
				return 'Valid email required (e.g. you@example.com)';
			}
			if (el.validity.patternMismatch) {
				if (el.name === 'phone') {
					return 'Philippine format required (e.g. 09171234567 or +639171234567)';
				}
				if (el.name === 'payment-ref') {
					return '13-digit numeric transaction reference required';
				}
				return 'Please match the required format';
			}
			if (el.name === 'payment-slip' && el.validity.customError)
				return el.validationMessage;
			return el.validationMessage || 'Invalid input';
		}

		function showError(
			el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
		) {
			el.classList.add('!border-registration', '!bg-registration/5');
			el.setAttribute('aria-invalid', 'true');
			const parent = el.closest('label') || el.parentElement;
			if (!parent) return;

			let err = parent.querySelector<HTMLElement>('[data-error-msg]');
			const msg = getErrorMessage(el);
			const errorId = `${el.name || 'field'}-error`;

			if (!err) {
				err = document.createElement('p');
				err.setAttribute('data-error-msg', '');
				err.id = errorId;
				err.className =
					'field-error mt-1 flex items-center gap-1 font-condensed text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-registration';
				parent.appendChild(err);
			}
			const icon = document.createElement('span');
			icon.setAttribute('aria-hidden', 'true');
			icon.textContent = '[!]';
			err.replaceChildren(icon, document.createTextNode(` ${msg}`));
			const describedBy =
				el
					.getAttribute('aria-describedby')
					?.split(/\s+/)
					.filter(id => id && id !== errorId) ?? [];
			el.setAttribute('aria-describedby', [...describedBy, errorId].join(' '));
		}

		function clearError(
			el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
		) {
			el.classList.remove('!border-registration', '!bg-registration/5');
			el.removeAttribute('aria-invalid');
			const parent = el.closest('label') || el.parentElement;
			const err = parent?.querySelector('[data-error-msg]');
			if (err) {
				const errorId = err.id;
				err.remove();
				const describedBy =
					el
						.getAttribute('aria-describedby')
						?.split(/\s+/)
						.filter(id => id && id !== errorId) ?? [];
				if (describedBy.length)
					el.setAttribute('aria-describedby', describedBy.join(' '));
				else el.removeAttribute('aria-describedby');
			}
		}

		let firstInvalidEl:
			(HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) | null =
			null;

		form
			?.querySelectorAll<
				HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
			>('input, select, textarea')
			.forEach(el => {
				el.addEventListener('invalid', e => {
					e.preventDefault();
					showError(el);
					if (!firstInvalidEl) {
						firstInvalidEl = el;
					}
				});
				el.addEventListener('input', () => {
					if (el.validity.valid) {
						clearError(el);
					}
				});
				el.addEventListener('change', () => {
					if (el.validity.valid) {
						clearError(el);
					}
				});
			});

		paymentSlipInput?.addEventListener('change', () => {
			const file = paymentSlipInput.files?.[0];
			let message = '';
			if (file?.size && file.size > PAYMENT_SLIP_MAX_BYTES) {
				message = 'Receipt files must be 4 MB or smaller.';
			} else if (
				file?.size &&
				!['image/jpeg', 'image/png', 'image/webp', 'application/pdf'].includes(
					file.type,
				)
			) {
				message = 'Choose a JPG, PNG, WebP, or PDF receipt.';
			}
			paymentSlipInput.setCustomValidity(message);
			if (paymentSlipInput.validity.valid) clearError(paymentSlipInput);
		});

		form?.addEventListener('submit', async e => {
			e.preventDefault();
			if (isSubmitting) return;
			firstInvalidEl = null;
			if (!cartItems.get().length) {
				showCheckoutError(
					'Your order slip is empty. Add a print before submitting.',
				);
				return;
			}
			if (errBox) errBox.classList.add('hidden');

			if (!form.checkValidity()) {
				setTimeout(() => {
					firstInvalidEl?.focus();
				}, 10);
				return;
			}

			orderNote.set(note?.value ?? '');
			refreshDelivery();
			if (cartField) {
				cartField.value = JSON.stringify(
					cartItems.get().map(({ sku, qty }) => ({ sku, qty })),
				);
			}

			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.textContent = 'Sending order request…';
				submitBtn.setAttribute('aria-busy', 'true');
			}
			isSubmitting = true;

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					credentials: 'same-origin',
					headers: { accept: 'application/json' },
				});

				if (response.ok && response.redirected) {
					window.location.assign(response.url);
					return;
				}

				const responseText = await response.text();
				let message = `We could not confirm your order (error ${response.status}). Please try again; your details are still here.`;
				try {
					const payload: unknown = JSON.parse(responseText);
					if (
						typeof payload === 'object' &&
						payload !== null &&
						'message' in payload &&
						typeof payload.message === 'string'
					) {
						message = payload.message;
					}
				} catch {
					console.error(
						'Order service returned an unreadable error response.',
						response.status,
					);
				}
				showCheckoutError(message);
			} catch (error) {
				console.error(
					'Order request could not be sent.',
					error instanceof Error ? error.name : 'Unknown error',
				);
				showCheckoutError(
					'We could not reach the order service. Your details are still here; check your connection and try again.',
				);
			} finally {
				if (submitBtn) {
					submitBtn.disabled = false;
					submitBtn.textContent = submitLabel;
					submitBtn.removeAttribute('aria-busy');
				}
				isSubmitting = false;
			}
		});
	}

	// Handle success state from URL params
	const urlParams = new URLSearchParams(window.location.search);
	if (urlParams.get('success') === '1') {
		clearCart();
	}
</script>
