---
import MainLayout from '../layouts/MainLayout.astro';
import { contact } from '../config/site';

const heading = 'font-condensed text-sm font-bold uppercase tracking-[0.18em]';
---

<MainLayout
  title="Contact Us — KALYE NOIR Street Wear Manila"
  description="Reach the Kalye Noir team for order, shipping, sizing or product concerns — mobile, email and the official Facebook page are all listed here."
>
  <section class="wrap py-14">
    <h1 class="display reveal text-center text-4xl sm:text-5xl">Contact Us</h1>
    <p class="meta mx-auto mt-6 max-w-2xl text-center text-[13px] tracking-[0.18em] text-muted">
      Please don't hesitate to contact us for any concerns or clarifications!
    </p>

    <div class="mx-auto mt-14 max-w-xl">
      <section>
        <h2 class={heading}>Phone</h2>
        <div class="mt-5">
          <p class="text-sm font-semibold">Orders/Shipping Inquiry</p>
          <ul class="mt-2 list-disc pl-5 text-sm text-muted">
            <li>Mobile - {contact.mobile}</li>
          </ul>
        </div>
      </section>

      <section class="mt-11">
        <h2 class={heading}>Email</h2>
        <ul class="mt-3 list-disc pl-5 text-sm text-muted">
          <li>
            <a
              href={`mailto:${contact.email}`}
              class="underline underline-offset-4 transition-colors hover:text-registration">{contact.email}</a
            >
          </li>
        </ul>
      </section>

      <section class="mt-11">
        <h2 class={heading}>Official Facebook Page</h2>
        <ul class="mt-3 list-disc pl-5 text-sm text-muted">
          <li>
            <a
              href={`https://${contact.facebook}`}
              rel="noopener"
              class="underline underline-offset-4 transition-colors hover:text-registration">{contact.facebook}</a
            >
          </li>
        </ul>
      </section>

      <a
        href="/incident-report"
        class="mt-16 block font-condensed text-lg font-bold uppercase leading-snug tracking-[0.06em] underline decoration-2 underline-offset-[6px] transition-colors hover:text-registration sm:text-xl"
      >
        For any concerns on your items, please click this to complete an incident report.
      </a>
    </div>
  </section>
</MainLayout>
