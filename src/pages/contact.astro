---
import MainLayout from '../layouts/MainLayout.astro';
import { contact } from '../config/site';

const isIncidentSuccess = Astro.url.searchParams.get('incident') === '1';
---

<MainLayout
	title="Contact Us · KALYE NOIR Street Wear Manila"
	description="Reach the Kalye Noir team for order, shipping, sizing or product concerns: mobile, email and the official Facebook page are all listed here."
>
	<div class="wrap pt-7">
		<nav
			class="meta flex items-center gap-2 text-navy"
			aria-label="Breadcrumb"
		>
			<a href="/" class="transition-colors hover:text-navy">
				Home
			</a>
			<span aria-hidden="true">/</span>
			<span class="text-ink">Contact us</span>
		</nav>
	</div>

	<section class="wrap py-12">
		{isIncidentSuccess ? (
			<div class="text-center">
				<div class="mb-6 flex h-16 w-16 items-center justify-center border border-dashed border-hairline mx-auto">
					<span
						class="h-3 w-3 bg-accent"
						aria-hidden="true"
					></span>
				</div>
				<h1 class="display reveal text-4xl sm:text-5xl">
					Incident report received
				</h1>
				<p class="mt-6 max-w-md mx-auto text-sm leading-relaxed text-ink/70">
					Your report was submitted. The support team will review the details
					and contact you if more information is needed.
				</p>
				<a href="/products" class="btn btn-primary mt-8 inline-block">
					Explore Batch 001
				</a>
			</div>
		) : (
			<>
				<header class="text-center">
					<h1 class="display reveal text-4xl sm:text-5xl">Contact us</h1>
					<p class="meta mx-auto mt-4 max-w-xl text-navy">
						Direct dispatch line, studio email, and order support.
					</p>
				</header>

				<div class="mx-auto mt-12 max-w-xl space-y-6">
					<div class="rounded-lg border border-hairline bg-paper p-6 transition-colors hover:border-plate">
						<p class="meta text-navy">Phone inquiry</p>
						<p class="mt-2 text-sm font-bold text-ink">
							Orders &amp; shipping desk
						</p>
						<p class="mt-1 text-sm text-ink/70">
							Mobile:{' '}
							<a
								href={`tel:${contact.mobile.replace(/\s+/g, '')}`}
								class="tap [overflow-wrap:anywhere] font-bold text-ink underline underline-offset-4 transition-colors hover:text-navy"
							>
								{contact.mobile}
							</a>
						</p>
					</div>

					<div class="rounded-lg border border-hairline bg-paper p-6 transition-colors hover:border-plate">
						<p class="meta text-navy">Direct email</p>
						<p class="mt-2 text-sm font-bold text-ink">
							General &amp; sizing concerns
						</p>
						<p class="mt-1 text-sm">
							<a
								href={`mailto:${contact.email}`}
								class="tap [overflow-wrap:anywhere] text-ink underline underline-offset-4 transition-colors hover:text-navy"
							>
								{contact.email}
							</a>
						</p>
					</div>

					<div class="rounded-lg border border-hairline bg-paper p-6 transition-colors hover:border-plate">
						<p class="meta text-navy">Official channel</p>
						<p class="mt-2 text-sm font-bold text-ink">
							Facebook community page
						</p>
						<p class="mt-1 text-sm">
							<a
								href={`https://${contact.facebook}`}
								target="_blank"
								rel="noopener noreferrer"
								class="tap [overflow-wrap:anywhere] text-ink underline underline-offset-4 transition-colors hover:text-navy"
							>
								{contact.facebook}
							</a>
						</p>
					</div>

					<div class="rounded-lg border border-hairline bg-ink p-6 text-paper">
						<div class="flex items-center gap-2">
							<span
								class="h-2 w-2 bg-accent"
								aria-hidden="true"
							></span>
							<span class="meta text-paper/70">Order claims</span>
						</div>
						<p class="mt-2 text-base font-bold">
							Missing, damaged, or incorrect items?
						</p>
						<p class="mt-1 text-sm text-paper/80 leading-relaxed">
							File an official claims ticket with your order slip and photo
							verification so our team can resolve it.
						</p>
						<a href="/incident-report" class="btn btn-invert mt-5 inline-block">
							File incident report
						</a>
					</div>
				</div>
			</>
		)}
	</section>
</MainLayout>
