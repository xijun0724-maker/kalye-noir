---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { products } from '../data/catalog';
import { site, taglines } from '../config/site';

// The drop — one poster per print. Poster art lives in /Assets.
const drop = [
  {
    index: '001',
    name: 'KALYENOIR',
    poster: '/assets/images/design/kalyenoir-poster.jpg',
    alt: 'KalyeNoir poster — the wordmark stacked across a Manila street sign',
    href: '/products/kalyenoir-tee',
    line: 'Real dreams, same sky',
  },
  {
    index: '002',
    name: 'MEDUSA',
    poster: '/assets/images/design/medusa-poster.jpg',
    alt: 'Medusa poster — a hand-drawn gorgon with snakes for hair',
    href: '/products/medusa-tee',
    line: 'Not your myth',
  },
  {
    index: '003',
    name: 'MANILA',
    poster: '/assets/images/design/manila-poster.jpg',
    alt: 'Manila poster — a jeepney on a crowded Manila street',
    href: '/products/manila-tee',
    line: 'The city never sleeps',
  },
];

const marquee = ['Kalye Noir', ...taglines, 'Street wear · Manila', 'Order by request'];
---

<MainLayout title={site.title} description={site.description}>
  <!-- ============ HERO ============ -->
  <section class="grain relative overflow-hidden bg-ink text-paper">
    <span class="absolute left-8 top-0 h-24 w-px bg-registration/70 sm:left-12"></span>
    <span class="absolute bottom-0 right-8 h-24 w-px bg-registration/70 sm:right-12"></span>

    <div class="wrap grid gap-12 py-16 lg:grid-cols-[1.02fr_1fr] lg:gap-20 lg:py-24">
      <figure class="reveal relative">
        <img
          src="/assets/images/design/kalyenoir-poster.jpg"
          alt="Kalye Noir KALYENOIR poster — the wordmark stacked beside a Manila street sign"
          width="1000"
          height="1294"
          class="w-full border border-paper/15 shadow-[0_40px_80px_-40px_rgba(0,0,0,0.9)]"
        />
        <figcaption class="meta mt-4 flex items-center justify-between text-paper/45">
          <span>001 / 003</span>
          <span class="flex items-center gap-3">
            Est. 2026
            <span class="barcode h-3.5 w-16 text-paper/50"></span>
          </span>
        </figcaption>
      </figure>

      <div class="flex flex-col justify-center">
        <p class="meta reveal reveal-2 flex items-center gap-3 text-registration">
          <span class="h-px w-8 bg-registration"></span>
          Drop 001 — Street wear · Manila
        </p>

        <h1 class="display reveal reveal-2 mt-6 text-[3.25rem] sm:text-6xl lg:text-7xl xl:text-8xl">
          Nasa kalye<br />nangangarap
        </h1>

        <p class="reveal reveal-3 mt-7 max-w-md text-paper/70">
          Three prints, heavyweight cotton, cut for the ones still out there. Late nights, early
          dreams — the street is the studio.
        </p>

        <div class="reveal reveal-3 mt-9 flex flex-wrap gap-3">
          <a href="#drop" class="btn btn-invert">See the drop</a>
          <a href="/products" class="btn btn-ghost">Shop now</a>
        </div>

        <div class="meta reveal reveal-3 mt-12 flex flex-wrap items-center gap-x-6 gap-y-3 text-paper/45">
          <span>14.5995° N — 120.9842° E</span>
          <Icon name="mdi:web" width={18} height={18} class="text-paper/40" />
          <span>Heavyweight cotton · S–2XL</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <div class="overflow-hidden border-y border-ink bg-registration py-3">
    <div class="marquee flex w-max">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0" aria-hidden="true">
            {marquee.map((item) => (
              <span class="meta mx-7 flex items-center gap-7 whitespace-nowrap font-semibold text-paper">
                {item}
                <span class="inline-block h-1.5 w-1.5 rotate-45 bg-paper/70" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- ============ THE DROP ============ -->
  <section id="drop" class="wrap py-16 lg:py-24">
    <header class="flex flex-wrap items-end justify-between gap-6 border-b-2 border-ink pb-5">
      <h2 class="display text-4xl sm:text-5xl">The drop</h2>
      <p class="meta text-muted">003 prints · limited stock</p>
    </header>

    <ul class="mt-10 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {
        drop.map((print, i) => (
          <li class={i === 1 ? 'lg:mt-16' : ''}>
            <a href={print.href} class="group block">
              <div class="relative overflow-hidden bg-ink">
                <img
                  src={print.poster}
                  alt={print.alt}
                  width="800"
                  height="1035"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[3/4] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                />
                <span class="absolute left-0 top-0 h-1 w-0 bg-registration transition-all duration-500 group-hover:w-full" />
                <span class="meta absolute right-3 top-3 text-paper/60">{print.index}</span>
              </div>
              <div class="mt-4 flex items-baseline justify-between gap-4">
                <h3 class="display text-2xl">{print.name}</h3>
                <span class="meta text-muted transition-colors group-hover:text-registration">
                  View tee →
                </span>
              </div>
              <p class="meta mt-1 text-muted">{print.line}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ ORDER THE TEES ============ -->
  <section class="border-t border-line bg-line/20">
    <div class="wrap flex flex-wrap items-end justify-between gap-4 pt-12">
      <h2 class="display text-4xl sm:text-5xl">Kalye's Tee</h2>
      <p class="meta text-muted">No prices here — we confirm per order</p>
    </div>
    <ProductGrid products={products} />
  </section>
</MainLayout>
