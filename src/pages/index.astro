---
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import { site } from '../config/site';
import { products } from '../data/catalog';
import { productArt } from '../data/productArt';

import homeBannerOne from '../assets/images/brand/home-banner-1.jpg';
import homeBannerTwo from '../assets/images/brand/home-banner-2.jpg';

import drop01 from '../assets/images/gallery/drop-01.jpg';
import drop02 from '../assets/images/gallery/drop-02.jpg';
import drop03 from '../assets/images/gallery/drop-03.jpg';
import drop05 from '../assets/images/gallery/drop-05.jpg';
import drop06 from '../assets/images/gallery/drop-06.jpg';
import drop07 from '../assets/images/gallery/drop-07.jpg';
import drop08 from '../assets/images/gallery/drop-08.jpg';
import drop09 from '../assets/images/gallery/drop-09.jpg';
import drop10 from '../assets/images/gallery/drop-10.jpg';
import drop12 from '../assets/images/gallery/drop-12.jpg';

---

<MainLayout title={site.title} description={site.description}>
	<!-- 1. Hero Section (Matches Laureti Page 1 with Title on Top and CTA at Bottom) -->
	<section class="relative h-[88vh] min-h-[600px] w-full overflow-hidden bg-paper">
		<Image
			src={homeBannerOne}
			alt="Kalye Noir crew wearing tees on a Manila street"
			widths={[640, 1024, 1440, 1920]}
			sizes="100vw"
			format="webp"
			priority
			class="h-full w-full object-cover object-center"
		/>
		<!-- Subtle top and bottom vignettes so the middle of the image stays 100% visible -->
		<div class="absolute inset-0 bg-gradient-to-b from-ink/65 via-transparent via-50% to-ink/70 pointer-events-none"></div>

		<!-- Container with Title on Top and Shop Now Button at Bottom -->
		<div class="absolute inset-0 flex flex-col justify-between items-center text-center px-4 py-8 sm:py-12 z-10 pointer-events-none">
			<!-- KALYE NOIR on top with on-brand tagline -->
			<div class="pointer-events-auto pt-2 sm:pt-4">
				<h1 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-normal tracking-[-0.025em] text-white uppercase drop-shadow-md">
					{site.name}
				</h1>
				<p class="font-title text-xs sm:text-sm uppercase tracking-[0.28em] text-paper/90 drop-shadow-md mt-2">
					Nasa Kalye Pangarap
				</p>
			</div>

			<!-- SHOP NOW at the bottom -->
			<div class="pointer-events-auto pb-4 sm:pb-6">
				<a
					href="/products"
					class="btn btn-primary px-9 py-4 font-title text-xs sm:text-sm font-semibold uppercase tracking-[0.24em] cursor-pointer shadow-panel hover:bg-accent transition-colors"
				>
					Shop Batch 001
				</a>
			</div>
		</div>
	</section>

	<!-- 2. Craftsmanship Image & National Statement Bar (Matches Laureti Page 2 & 3) -->
	<section class="w-full bg-paper">
		<div class="relative w-full h-[55vh] min-h-[380px] overflow-hidden">
			<Image
				src={drop02}
				alt="Kalye Noir artisan and screen-print craftsmanship in Manila"
				widths={[640, 1024, 1440, 1920]}
				sizes="100vw"
				format="webp"
				loading="lazy"
				class="h-full w-full object-cover object-center filter grayscale contrast-110"
			/>
		</div>
		<!-- Ink Black Statement Strip with Control Lines -->
		<div class="w-full bg-ink py-5 px-4 text-center border-y border-plate">
			<p class="font-sans text-sm sm:text-base text-paper/95 tracking-wide">
				Manila never sleeps. Small-batch 240 GSM tees cut, sewn, and hand-pulled by <strong class="font-bold text-paper">Filipino makers</strong>.
			</p>
		</div>
	</section>

	<!-- 3. Category Feature Banner: KALYE TEES (Matches Laureti Page 3 with Title on Top and Tagline at Bottom) -->
	<section class="relative w-full h-[80vh] min-h-[560px] sm:h-[88vh] sm:min-h-[640px] overflow-hidden bg-paper">
		<Image
			src={homeBannerTwo}
			alt="Kalye Noir street collection in Manila"
			widths={[640, 1024, 1440, 1920]}
			sizes="100vw"
			format="webp"
			loading="lazy"
			class="h-full w-full object-cover object-[center_35%]"
		/>
		<!-- Subtle gradient overlays at top and bottom so the models in the center stay 100% visible -->
		<div class="absolute inset-0 bg-gradient-to-b from-ink/75 via-transparent via-40% to-ink/70 pointer-events-none"></div>

		<!-- Container with ONLY text: Nasa Kalye and Pangarap at the top so image is 100% visible -->
		<div class="absolute inset-0 flex flex-col justify-start items-center text-center pt-8 sm:pt-14 px-4 z-10 pointer-events-none">
			<h2 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-normal tracking-[-0.025em] text-white uppercase drop-shadow-lg">
				Nasa Kalye <span class="text-accent">Pangarap</span>
			</h2>
		</div>
	</section>

	<!-- 4. Best Selling Product Grid (Matches Laureti Page 3, 4, 5) -->
	<section class="w-full bg-paper py-16 sm:py-20">
		<div class="wrap text-center">
			<p class="font-title text-xs uppercase tracking-[0.28em] text-accent font-semibold mb-2">
				Heavyweight 240 GSM Cotton
			</p>
			<h2 class="font-display text-3xl sm:text-4xl md:text-5xl uppercase tracking-[-0.025em] text-ink mb-3 sm:mb-4">
				The Core Prints
			</h2>
			<p class="font-sans text-xs sm:text-sm text-navy max-w-md mx-auto mb-12 sm:mb-16">
				Three small-batch silkscreen prints, hand-cured for lasting grit. Black cotton only.
			</p>

			<div class="grid grid-cols-2 lg:grid-cols-3 gap-x-6 sm:gap-x-8 gap-y-12 sm:gap-y-16 max-w-5xl mx-auto">
				{products.map(product => (
					<a href={`/products/${product.slug}`} class="group block text-center">
							<div class="relative overflow-hidden bg-white p-4 border border-hairline">
								<Image
									src={productArt[product.slug]}
									alt={product.alt}
									widths={[240, 360, 480]}
									sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 48vw"
									format="webp"
									loading="lazy"
									class="aspect-[4/5] w-full object-contain transition-transform duration-500 ease-out group-hover:scale-[1.04]"
								/>
							</div>

							<div class="pt-4 text-center">
								<h3 class="font-title text-xs uppercase tracking-[0.18em] font-semibold text-ink transition-colors group-hover:text-accent">
									{product.title}
								</h3>
								<p class="font-title text-[11px] uppercase tracking-[0.2em] text-accent font-semibold mt-1">
									Limited Edition · 1st Edition
								</p>
								<div class="mt-1 flex items-baseline justify-center gap-2 text-xs font-title tracking-wider">
									<span class="font-bold text-ink">₱{product.price}.00</span>
								</div>
							</div>
						</a>
					))}
			</div>

			<div class="mt-14 sm:mt-16">
				<a
					href="/products"
					class="btn btn-primary px-10 py-3.5 font-title text-xs font-semibold uppercase tracking-[0.24em] cursor-pointer"
				>
					View All
				</a>
			</div>
		</div>
	</section>

	<!-- 5. 4-Photo Maker / Community Collage: "You make this possible." (Matches Laureti Page 7) -->
	<section class="relative w-full bg-ink">
		<div class="grid grid-cols-2 md:grid-cols-4 w-full h-[60vh] min-h-[400px]">
			<div class="relative h-full overflow-hidden">
				<Image
					src={drop07}
					alt="Kalye Noir community maker 1"
					widths={[360, 640]}
					sizes="25vw"
					format="webp"
					loading="lazy"
					class="h-full w-full object-cover"
				/>
			</div>
			<div class="relative h-full overflow-hidden">
				<Image
					src={drop08}
					alt="Kalye Noir community maker 2"
					widths={[360, 640]}
					sizes="25vw"
					format="webp"
					loading="lazy"
					class="h-full w-full object-cover"
				/>
			</div>
			<div class="relative h-full overflow-hidden">
				<Image
					src={drop09}
					alt="Kalye Noir community maker 3"
					widths={[360, 640]}
					sizes="25vw"
					format="webp"
					loading="lazy"
					class="h-full w-full object-cover"
				/>
			</div>
			<div class="relative h-full overflow-hidden">
				<Image
					src={drop10}
					alt="Kalye Noir community maker 4"
					widths={[360, 640]}
					sizes="25vw"
					format="webp"
					loading="lazy"
					class="h-full w-full object-cover"
				/>
			</div>
		</div>
		<div class="absolute inset-0 bg-ink/35 pointer-events-none"></div>
		<div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center text-center px-4">
			<h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-normal text-white uppercase tracking-[-0.025em] drop-shadow-lg">
				Real Streets. <span class="text-accent">Real Stories.</span>
			</h2>
			<p class="font-title text-xs sm:text-sm uppercase tracking-[0.24em] text-paper/90 mt-3 drop-shadow-md">
				Beauty in Chaos · Feared by Many · Worn in Manila
			</p>
		</div>
	</section>

	<!-- 6. Purpose / Story Section: "Not Your Myth" -->
	<section class="relative w-full h-[55vh] min-h-[380px] overflow-hidden bg-paper">
		<Image
			src={drop05}
			alt="Kalye Noir purpose and streetwear culture"
			widths={[640, 1024, 1440, 1920]}
			sizes="100vw"
			format="webp"
			loading="lazy"
			class="h-full w-full object-cover object-center"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-ink/80 via-ink/40 to-transparent pointer-events-none"></div>
		<div class="absolute inset-0 flex flex-col items-start justify-center wrap px-6 sm:px-12">
			<h2 class="font-display text-4xl sm:text-5xl md:text-6xl text-white font-normal uppercase tracking-[-0.025em] drop-shadow-md">
				Not Your <span class="text-accent font-bold">Myth.</span>
			</h2>
			<p class="font-title text-xs sm:text-sm uppercase tracking-[0.22em] text-paper/90 mt-3 drop-shadow-sm max-w-lg">
				Small-batch silkscreen prints rooted in Manila grit and mythos.
			</p>
		</div>
	</section>

	<!-- 7. 4-Photo Strip with Nationwide Banner Quote -->
	<section class="relative w-full bg-ink">
		<div class="grid grid-cols-2 md:grid-cols-4 w-full h-[38vh] min-h-[260px]">
			<div class="relative h-full overflow-hidden">
				<Image
					src={drop01}
					alt="Kalye Noir street scene 1"
					widths={[320, 600]}
					sizes="25vw"
					format="webp"
					loading="lazy"
					class="h-full w-full object-cover"
				/>
			</div>
			<div class="relative h-full overflow-hidden">
				<Image
					src={drop03}
					alt="Kalye Noir street scene 2"
					widths={[320, 600]}
					sizes="25vw"
					format="webp"
					loading="lazy"
					class="h-full w-full object-cover"
				/>
			</div>
			<div class="relative h-full overflow-hidden">
				<Image
					src={drop06}
					alt="Kalye Noir street scene 3"
					widths={[320, 600]}
					sizes="25vw"
					format="webp"
					loading="lazy"
					class="h-full w-full object-cover"
				/>
			</div>
			<div class="relative h-full overflow-hidden">
				<Image
					src={drop12}
					alt="Kalye Noir street scene 4"
					widths={[320, 600]}
					sizes="25vw"
					format="webp"
					loading="lazy"
					class="h-full w-full object-cover"
				/>
			</div>
		</div>
		<div class="absolute inset-0 bg-ink/25 pointer-events-none"></div>
		<div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center text-center px-4">
			<p class="font-display text-2xl sm:text-3xl md:text-4xl font-normal uppercase tracking-[-0.015em] text-white drop-shadow-lg">
				Late Nights. Early Dreams. <span class="text-accent">Kalye Noir.</span>
			</p>
			<p class="font-title text-xs sm:text-sm uppercase tracking-[0.24em] text-paper/85 mt-2 drop-shadow-md">
				100% Combed Heavyweight Cotton · Est. 2026
			</p>
		</div>
	</section>

	<!-- 8. Floating Limited Edition Drop Toast -->
	<aside
		data-sale-toast
		class="fixed bottom-6 right-6 z-30 max-w-sm bg-ink text-paper border border-plate p-5 shadow-panel transition-all duration-300"
		aria-label="Limited edition collection alert"
	>
		<div class="flex items-start justify-between gap-4">
			<div>
				<p class="font-title text-sm font-bold uppercase tracking-[0.24em] text-accent">
					Limited Edition · 1st Edition
				</p>
				<p class="font-sans text-xs text-paper/90 mt-1">
					Batch 001 small-batch heavyweight drop. <a href="/products" class="font-semibold underline underline-offset-2 hover:text-accent">Explore 1st Edition prints →</a>
				</p>
			</div>
			<button
				type="button"
				data-toast-close
				aria-label="Dismiss alert"
				class="text-paper/70 hover:text-paper text-lg leading-none cursor-pointer -mr-1 -mt-1 p-1"
			>
				✕
			</button>
		</div>
	</aside>
</MainLayout>

<script>
	// Surprise Sale Toast dismiss logic
	const toast = document.querySelector<HTMLElement>('[data-sale-toast]');
	const closeBtn = document.querySelector<HTMLButtonElement>('[data-toast-close]');

	closeBtn?.addEventListener('click', () => {
		if (toast) {
			toast.style.opacity = '0';
			toast.style.transform = 'translateY(16px)';
			setTimeout(() => {
				toast.style.display = 'none';
			}, 300);
		}
	});
</script>