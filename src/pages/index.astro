---
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import { site, taglines } from '../config/site';
import posterKalyenoir from '../assets/images/design/kalyenoir-poster.jpg';
import posterMedusa from '../assets/images/design/medusa-poster.jpg';
import posterManila from '../assets/images/design/manila-poster.jpg';

// The drop — one poster per print. Poster art lives in src/assets/images/design.
const drop = [
  {
    name: 'KALYENOIR',
    poster: posterKalyenoir,
    alt: 'KalyeNoir poster — the wordmark stacked across a Manila street sign',
    href: '/products/kalyenoir-tee',
    line: 'Real dreams, same sky',
  },
  {
    name: 'MEDUSA',
    poster: posterMedusa,
    alt: 'Medusa poster — a hand-drawn gorgon with snakes for hair',
    href: '/products/medusa-tee',
    line: 'Not your myth',
  },
  {
    name: 'MANILA',
    poster: posterManila,
    alt: 'Manila poster — a jeepney on a crowded Manila street',
    href: '/products/manila-tee',
    line: 'The city never sleeps',
  },
];

const marquee = ['Kalye Noir', ...taglines, 'Street wear · Manila', 'Order by request'];
---

<MainLayout title={site.title} description={site.description}>
  <!-- ============ HERO ============ -->
  <section class="grain relative overflow-hidden bg-ink text-paper">
    <span class="absolute left-8 top-0 h-24 w-px bg-registration/70 sm:left-12"></span>
    <span class="absolute bottom-0 right-8 h-24 w-px bg-registration/70 sm:right-12"></span>

    <div class="wrap grid gap-12 py-16 lg:grid-cols-[1.02fr_1fr] lg:gap-20 lg:py-24">
      <figure class="reveal relative">
        <Image
          src={posterKalyenoir}
          alt="Kalye Noir KALYENOIR poster — the wordmark stacked beside a Manila street sign"
          widths={[400, 600, 800, 1000]}
          sizes="(min-width: 1024px) 48vw, 92vw"
          format="webp"
          fetchpriority="high"
          loading="eager"
          class="w-full border border-paper/15 shadow-[0_40px_80px_-40px_rgba(0,0,0,0.9)]"
        />
        <figcaption class="meta mt-4 flex items-center justify-between text-paper/75">
          <span>001 / 003</span>
          <span class="flex items-center gap-3">
            Est. 2026
            <span class="barcode h-3.5 w-16 text-paper/70"></span>
          </span>
        </figcaption>
      </figure>

      <div class="flex flex-col justify-center">
        <h1 class="display reveal reveal-2 text-5xl sm:text-6xl lg:text-7xl xl:text-8xl">
          Nasa kalye<br />nangangarap
        </h1>

        <p class="reveal reveal-3 mt-7 max-w-md text-paper/80">
          Three prints, heavyweight cotton, cut for the ones still out there. Late nights, early
          dreams — the street is the studio.
        </p>

        <div class="reveal reveal-3 mt-9 flex flex-wrap gap-3">
          <a href="#drop" class="btn btn-invert">See the drop</a>
          <a href="#how-it-works" class="btn btn-ghost">How ordering works</a>
        </div>

        <div class="meta reveal reveal-3 mt-12 flex flex-wrap items-center gap-x-6 gap-y-3 text-paper/70">
          <span>14.5995° N — 120.9842° E</span>
          <svg viewBox="0 0 24 24" width="18" height="18" class="text-paper/60">
            <path
              fill="currentColor"
              d="M16.36 14c.08-.66.14-1.32.14-2c0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2m-5.15 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56M14.34 14H9.66c-.1-.66-.16-1.32-.16-2c0-.68.06-1.35.16-2h4.68c.09.65.16 1.32.16 2c0 .68-.07 1.34-.16 2M12 19.96c-.83-1.2-1.5-2.53-1.91-3.96h3.82c-.41 1.43-1.08 2.76-1.91 3.96M8 8H5.08A7.923 7.923 0 0 1 9.4 4.44C8.8 5.55 8.35 6.75 8 8m-2.92 8H8c.35 1.25.8 2.45 1.4 3.56A8.008 8.008 0 0 1 5.08 16m-.82-2C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2c0 .68.06 1.34.14 2M12 4.03c.83 1.2 1.5 2.54 1.91 3.97h-3.82c.41-1.43 1.08-2.77 1.91-3.97M18.92 8h-2.95a15.65 15.65 0 0 0-1.38-3.56c1.84.63 3.37 1.9 4.33 3.56M12 2C6.47 2 2 6.5 2 12a10 10 0 0 0 10 10a10 10 0 0 0 10-10A10 10 0 0 0 12 2"
            />
          </svg>
          <span>Heavyweight cotton · S–2XL</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE BANNER ============ -->
  <div class="overflow-hidden border-y border-ink bg-registration py-3">
    <div
      class="marquee flex w-max motion-reduce:animate-none hover:[animation-play-state:paused] focus-within:[animation-play-state:paused]"
    >
      {
        [0, 1].map((copyIndex) => (
          <div class="flex shrink-0" aria-hidden={copyIndex > 0 ? 'true' : undefined}>
            {marquee.map((item) => (
              <span class="meta mx-7 flex items-center gap-7 whitespace-nowrap font-semibold text-paper">
                {item}
                <span class="inline-block h-1.5 w-1.5 rotate-45 bg-paper/70" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- ============ THE DROP (ART SHOWCASE) ============ -->
  <section id="drop" class="wrap py-16 lg:py-24">
    <header class="flex flex-wrap items-end justify-between gap-6 border-b-2 border-ink pb-5">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="inline-block h-1.5 w-1.5 rotate-45 bg-registration" aria-hidden="true"></span>
          <span class="meta text-registration font-semibold">Batch 001 Active · Manila Pressing</span>
        </div>
        <h2 class="display text-4xl sm:text-5xl">The drop</h2>
        <p class="meta mt-1 text-muted">003 Prints · Custom Screen-Print Tees</p>
      </div>
      <p class="meta text-muted">Heavyweight cotton · S–2XL</p>
    </header>

    <ul class="mt-12 grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      {
        drop.map((print, i) => (
          <li class={i === 1 ? 'lg:mt-12' : ''}>
            <a href={print.href} class="group block">
              <div class="relative overflow-hidden bg-ink">
                <Image
                  src={print.poster}
                  alt={print.alt}
                  widths={[300, 450, 600]}
                  sizes="(min-width: 1024px) 30vw, 92vw"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[3/4] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                />
                <span class="absolute left-0 top-0 h-1 w-0 bg-registration transition-all duration-500 group-hover:w-full" />
                <span class="meta absolute right-3 top-3 text-paper/70">
                  {String(i + 1).padStart(3, '0')}
                </span>
              </div>

              <div class="mt-4 flex items-baseline justify-between gap-4">
                <h3 class="display text-2xl transition-colors duration-200 group-hover:text-registration">
                  {print.name}
                </h3>
                <span class="meta text-xs text-muted transition-colors group-hover:text-registration">
                  View Tee →
                </span>
              </div>
              <p class="meta mt-1 text-muted">{print.line} · S–2XL</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ HOW ORDERING WORKS ============ -->
  <section id="how-it-works" class="border-t border-line bg-line/20 py-16 lg:py-24">
    <div class="wrap">
      <header class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-6">
        <div>
          <h2 class="display text-3xl sm:text-4xl">How Ordering Works</h2>
          <p class="meta mt-1 text-muted">Small-Batch Streetwear · Made in Manila</p>
        </div>
        <span class="meta text-xs text-muted">Order by Request Protocol</span>
      </header>

      <div class="mt-10 grid gap-8 md:grid-cols-3">
        <div class="border-t-2 border-ink pt-6">
          <span class="font-display text-4xl text-registration">01</span>
          <h3 class="font-condensed text-base font-semibold uppercase tracking-[0.16em] text-ink mt-2">
            Select Piece & Size
          </h3>
          <p class="mt-2 text-sm text-ink/75 leading-relaxed">
            Choose your print and preferred size (S–2XL). Add to your order request slip without immediate charge.
          </p>
        </div>

        <div class="border-t-2 border-ink pt-6">
          <span class="font-display text-4xl text-registration">02</span>
          <h3 class="font-condensed text-base font-semibold uppercase tracking-[0.16em] text-ink mt-2">
            Send Request Slip
          </h3>
          <p class="mt-2 text-sm text-ink/75 leading-relaxed">
            Submit your contact details and address at checkout. Your order queues straight into our workshop batch.
          </p>
        </div>

        <div class="border-t-2 border-ink pt-6">
          <span class="font-display text-4xl text-registration">03</span>
          <h3 class="font-condensed text-base font-semibold uppercase tracking-[0.16em] text-ink mt-2">
            Confirm & Dispatch
          </h3>
          <p class="mt-2 text-sm text-ink/75 leading-relaxed">
            A real person confirms stock and provides shipping numbers via email or message before dispatching from Manila.
          </p>
        </div>
      </div>

      <div class="mt-12 flex flex-wrap items-center justify-between gap-6 border-t border-line/60 pt-8">
        <p class="font-condensed text-xs uppercase tracking-[0.2em] text-ink/80">
          Ready to order? Browse the 3 drop pieces above or check the full catalog.
        </p>
        <a href="/products" class="btn btn-primary text-xs">
          Shop Now →
        </a>
      </div>
    </div>
  </section>
</MainLayout>
