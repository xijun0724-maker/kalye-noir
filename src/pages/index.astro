---
import Layout from '../layouts/Page.astro';
import { products } from '../data/products.js';

const seo = {
	title: 'Kalye Noir | Manila Streetwear — Oversized Shirts & Trinket Pouches',
	description:
		'Kalye Noir. Manila streetwear built for late nights and early dreams. Oversized shirts and a customizable trinket pouch. Nasa kalye nangangarap.',
};

const line = products.map((p) => ({
	name: p.short,
	caption: p.meta,
	img: p.img,
	alt: p.alt,
	href: `/products/${p.slug}`,
}));
---

<Layout {seo}>
	<!-- ============ HERO — the poster wall ============ -->
	<section class="hero" aria-labelledby="hero-title">
		<span class="hero__barcode" aria-hidden="true">
			<svg viewBox="0 0 88 22" preserveAspectRatio="none">
				<rect x="0" y="0" width="3" height="22"></rect>
				<rect x="5" y="0" width="1" height="22"></rect>
				<rect x="8" y="0" width="4" height="22"></rect>
				<rect x="14" y="0" width="1" height="22"></rect>
				<rect x="17" y="0" width="2" height="22"></rect>
				<rect x="21" y="0" width="4" height="22"></rect>
				<rect x="27" y="0" width="1" height="22"></rect>
				<rect x="30" y="0" width="3" height="22"></rect>
				<rect x="35" y="0" width="1" height="22"></rect>
				<rect x="38" y="0" width="4" height="22"></rect>
				<rect x="44" y="0" width="2" height="22"></rect>
				<rect x="48" y="0" width="1" height="22"></rect>
				<rect x="51" y="0" width="4" height="22"></rect>
				<rect x="57" y="0" width="1" height="22"></rect>
				<rect x="60" y="0" width="3" height="22"></rect>
				<rect x="65" y="0" width="1" height="22"></rect>
				<rect x="68" y="0" width="4" height="22"></rect>
				<rect x="74" y="0" width="2" height="22"></rect>
				<rect x="78" y="0" width="1" height="22"></rect>
				<rect x="81" y="0" width="3" height="22"></rect>
				<rect x="86" y="0" width="2" height="22"></rect>
			</svg>
		</span>

		<div class="hero__grid kn-wrap">
			<div class="hero__lead">
				<p class="kn-label hero__coords">14.5995° N — 120.9842° E</p>
				<h1 id="hero-title" class="hero__wordmark">Kalye<br />Noir</h1>
				<div class="kn-rule hero__rule"></div>
				<p class="hero__tagline">
					Street wear · Manila. Late nights, early dreams — real streets,
					real stories. Not your myth.
				</p>
				<div class="hero__actions">
					<a class="hero__cta" href="/products">
						Shop Now
						<svg viewBox="0 0 24 24" aria-hidden="true"
							><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"></path></svg
						>
					</a>
					<a class="hero__cta hero__cta--ghost" href="/cart">View cart</a>
				</div>
			</div>

			<div class="hero__plates">
				<figure class="plate plate--a">
					<img
						src="/assets/images/brand/banner-aesthetic-1.png"
						alt="Kalye Noir poster — the KALYENOIR wordmark over Manila, NASA KALYE NANGANGARAP"
						width="571"
						height="729"
					/>
				</figure>
				<figure class="plate plate--b">
					<img
						src="/assets/images/brand/banner-aesthetic-3.png"
						alt="Kalye Noir poster — MANILA NEVER SLEEPS, a jeepney on a Divisoria street"
						width="748"
						height="895"
						loading="lazy"
					/>
				</figure>
			</div>
		</div>
	</section>

	<!-- ============ SHIRT BANNER + SHOP NOW ============ -->
	<section class="banner" aria-labelledby="drop-title">
		<div class="banner__grid kn-wrap">
			<div class="banner__copy">
				<p class="kn-label">Oversized · Front &amp; back print · S–2XL</p>
				<h2 id="drop-title" class="banner__title">The Line</h2>
				<p class="banner__text">
					Three designs off the brand book — MEDUSA, MAYNILA, KALYENOIR —
					plus the GOOD THINGS INSIDE trinket pouch. Small-batch, made to
					order.
				</p>
				<a class="hero__cta" href="/products">
					Shop Now
					<svg viewBox="0 0 24 24" aria-hidden="true"
						><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"></path></svg
					>
				</a>
			</div>
			<figure class="banner__plate">
				<img
					src="/assets/images/brand/shirt-banner.png"
					alt="Kalye Noir shirts on a rail — white, sand, charcoal and black oversized tees"
					width="766"
					height="758"
					loading="lazy"
				/>
			</figure>
		</div>
	</section>

	<!-- ============ THE LINE ============ -->
	<section class="line" aria-labelledby="line-title">
		<div class="kn-wrap">
			<div class="line__head">
				<h2 id="line-title">Three shirts, one rail.</h2>
				<a class="line__more" href="/products">See all products →</a>
			</div>
			<ul class="line__grid">
				{
					line.map((item) => (
						<li class="line__item">
							<a href={item.href}>
								<figure class="line__plate">
									<img src={item.img} alt={item.alt} loading="lazy" decoding="async" />
								</figure>
								<p class="kn-label">{item.caption}</p>
								<h3>{item.name}</h3>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ============ MANIFESTO ============ -->
	<section class="manifesto" aria-labelledby="mf-title">
		<div class="manifesto__grid kn-wrap">
			<div class="manifesto__copy">
				<p class="kn-label kn-label--on-ink">The brand book · Page one</p>
				<h2 id="mf-title" class="manifesto__title">Manila<br />never<br />sleeps</h2>
				<p class="manifesto__text">
					Beauty in chaos. Feared by many. Legends never die. Every piece
					carries the street it came from — the wires, the jeepneys, the
					late-night glow.
				</p>
				<p class="kn-label kn-label--on-ink manifesto__motto">Nasa kalye nangangarap</p>
			</div>
			<figure class="manifesto__plate">
				<img
					src="/assets/images/brand/medusa-poster.png"
					alt="Kalye Noir MEDUSA poster — beauty in chaos, feared by many, legends never die"
					width="767"
					height="961"
					loading="lazy"
				/>
			</figure>
		</div>
	</section>

	<!-- ============ CLOSING CTA ============ -->
	<section class="closing" aria-labelledby="closing-title">
		<div class="kn-wrap closing__inner">
			<h2 id="closing-title" class="closing__title">Ready when you are.</h2>
			<div class="hero__actions">
				<a class="hero__cta" href="/products">
					Shop Now
					<svg viewBox="0 0 24 24" aria-hidden="true"
						><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"></path></svg
					>
				</a>
				<a class="hero__cta hero__cta--ghost" href="/cart">View cart</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* ---------- HERO ---------- */
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(2rem, 6vw, 4.5rem) clamp(3rem, 7vw, 6rem);
	}
	.hero__barcode {
		position: absolute;
		top: clamp(1rem, 3vw, 2rem);
		right: clamp(1.1rem, 4vw, 2.75rem);
		width: 88px;
		height: 22px;
		color: var(--kn-ink);
		opacity: 0.82;
	}
	.hero__barcode svg {
		width: 100%;
		height: 100%;
		fill: currentColor;
	}
	.hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: center;
	}
	.hero__coords {
		margin: 0 0 1.25rem 0;
	}
	.hero__wordmark {
		font-size: clamp(4.5rem, 15vw, 13rem);
		line-height: 0.82;
		letter-spacing: -0.025em;
		margin: 0;
	}
	.hero__rule {
		max-width: 12rem;
		margin: 1.5rem 0 1.25rem;
	}
	.hero__tagline {
		max-width: 34ch;
		font-size: var(--font-size-md);
		line-height: 1.4;
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
		margin-top: 1.75rem;
	}
	.hero__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.4rem;
		background: var(--kn-ink);
		color: var(--kn-paper);
		border: 2px solid var(--kn-ink);
		font-weight: 800;
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}
	.hero__cta svg {
		width: 20px;
		height: 20px;
		transition: transform var(--theme-transition);
	}
	.hero__cta:hover {
		background: var(--kn-red);
		border-color: var(--kn-red);
		color: var(--kn-paper);
		transform: translateY(-1px);
	}
	.hero__cta:hover svg {
		transform: translateX(0.2rem);
	}
	.hero__cta--ghost {
		background: transparent;
		color: var(--kn-ink);
		border-color: transparent;
		border-bottom: 2px solid var(--kn-ink);
		padding-inline: 0.1rem;
	}
	.hero__cta--ghost:hover {
		background: transparent;
		border-color: transparent;
		border-bottom-color: var(--kn-red);
		color: var(--kn-red);
		transform: none;
	}
	.hero__cta--light {
		background: var(--kn-paper);
		color: var(--kn-ink);
		border-color: var(--kn-paper);
	}
	.hero__cta--light:hover {
		background: var(--kn-red);
		border-color: var(--kn-red);
		color: var(--kn-paper);
	}

	.hero__plates {
		position: relative;
		justify-self: end;
		width: min(100%, 480px);
		aspect-ratio: 4 / 5;
	}
	.plate {
		position: absolute;
		margin: 0;
		padding: 0.5rem;
		background: var(--kn-paper);
		border: 1.5px solid var(--kn-ink);
		box-shadow: 0 22px 40px -18px rgba(18, 16, 14, 0.5);
		animation: kn-settle 0.75s var(--theme-hover-ease) both;
	}
	.plate img {
		width: 100%;
		height: auto;
		display: block;
	}
	.plate--a {
		width: 60%;
		top: 2%;
		right: 0;
		transform: rotate(3.2deg);
		animation-delay: 0.05s;
	}
	.plate--b {
		width: 54%;
		bottom: 2%;
		left: 0;
		transform: rotate(-4deg);
		animation-delay: 0.18s;
	}
	.plate:hover {
		transform: rotate(0deg) translateY(-6px);
		transition: transform 0.4s var(--theme-hover-ease);
		z-index: 2;
	}
	@keyframes kn-settle {
		from {
			opacity: 0;
			filter: blur(6px);
		}
		to {
			opacity: 1;
			filter: blur(0);
		}
	}

	/* ---------- SHIRT BANNER ---------- */
	.banner {
		margin-top: var(--section-margin);
		background: var(--kn-paper-2);
		border-block: 2px solid var(--kn-ink);
		padding-block: clamp(2.5rem, 6vw, 5rem);
	}
	.banner__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: center;
	}
	.banner__title {
		font-size: clamp(3rem, 8vw, 6.5rem);
		line-height: 0.86;
		margin: 0.5rem 0 1rem;
	}
	.banner__text {
		max-width: 40ch;
		margin-bottom: 1.75rem;
	}
	.banner__plate {
		margin: 0;
		border: 1.5px solid var(--kn-ink);
		box-shadow: 0 24px 44px -20px rgba(18, 16, 14, 0.5);
		background: var(--kn-paper);
	}
	.banner__plate img {
		width: 100%;
		height: auto;
		display: block;
	}

	/* ---------- THE LINE ---------- */
	.line {
		margin-top: var(--section-margin);
	}
	.line__head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1.25rem;
		border-bottom: 2px solid var(--kn-ink);
		margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}
	.line__head h2 {
		font-size: clamp(2.2rem, 6vw, 4.5rem);
		margin: 0;
	}
	.line__more {
		font-family: var(--theme-font-mono);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.16em;
		text-decoration: none;
		border-bottom: 2px solid var(--kn-ink);
		padding-bottom: 2px;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	.line__more:hover {
		color: var(--kn-red);
		border-color: var(--kn-red);
	}
	.line__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--theme-grid-gap);
	}
	.line__item a {
		display: block;
		text-decoration: none;
	}
	.line__plate {
		margin: 0 0 0.85rem;
		background: var(--kn-paper-2);
		border: 1.5px solid var(--kn-ink);
		aspect-ratio: 4 / 3;
		display: flex;
		align-items: center;
		overflow: hidden;
	}
	.line__plate img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		mix-blend-mode: multiply;
		transition: transform 0.5s var(--theme-hover-ease);
	}
	.line__item a:hover .line__plate img {
		transform: scale(1.04);
	}
	.line__item h3 {
		margin: 0.2rem 0 0;
		font-size: var(--font-size-md);
	}
	.line__item a:hover h3 {
		color: var(--kn-red);
	}

	/* ---------- MANIFESTO ---------- */
	.manifesto {
		margin-top: var(--section-margin);
		background: var(--kn-ink);
		color: var(--kn-paper);
		overflow: hidden;
	}
	.manifesto__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: center;
		padding-block: clamp(3rem, 7vw, 6rem);
	}
	.manifesto__title {
		font-size: clamp(3rem, 10vw, 8rem);
		line-height: 0.82;
		letter-spacing: -0.02em;
		margin: 0.75rem 0 1.5rem;
	}
	.manifesto__text {
		max-width: 42ch;
		color: color-mix(in srgb, var(--kn-paper) 82%, var(--kn-ink));
	}
	.manifesto__motto {
		margin-top: 1.5rem;
		color: var(--kn-red-bright);
	}
	.manifesto__plate {
		margin: 0;
		justify-self: end;
		width: min(100%, 380px);
		border: 1.5px solid color-mix(in srgb, var(--kn-paper) 45%, var(--kn-ink));
	}
	.manifesto__plate img {
		width: 100%;
		height: auto;
		display: block;
	}

	/* ---------- CLOSING CTA ---------- */
	.closing {
		margin-top: var(--section-margin);
	}
	.closing__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: clamp(2rem, 5vw, 3.5rem);
		border-block: 2px solid var(--kn-ink);
	}
	.closing__title {
		font-size: clamp(2.2rem, 6vw, 4.5rem);
		margin: 0;
	}

	/* ---------- responsive ---------- */
	@media (max-width: 860px) {
		.hero__grid,
		.banner__grid,
		.manifesto__grid {
			grid-template-columns: 1fr;
		}
		.hero__plates {
			justify-self: center;
			margin-top: 1.5rem;
			width: min(100%, 420px);
		}
		.banner__plate,
		.manifesto__plate {
			justify-self: start;
			width: min(100%, 440px);
		}
	}
	@media (max-width: 520px) {
		.hero__wordmark {
			font-size: clamp(3.5rem, 22vw, 6rem);
		}
	}
</style>
