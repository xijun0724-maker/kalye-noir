---
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import { site, taglines } from '../config/site';
import homeBannerOne from '../assets/images/brand/home-banner-1.jpg';
import homeBannerTwo from '../assets/images/brand/home-banner-2.jpg';
import posterKalyenoir from '../assets/images/design/kalyenoir-poster.jpg';
import posterMedusa from '../assets/images/design/medusa-poster.jpg';
import posterManila from '../assets/images/design/manila-poster.jpg';
import gallery01 from '../assets/images/gallery/drop-01.jpg';
import gallery02 from '../assets/images/gallery/drop-02.jpg';
import gallery03 from '../assets/images/gallery/drop-03.jpg';
import gallery04 from '../assets/images/gallery/drop-04.jpg';
import gallery05 from '../assets/images/gallery/drop-05.jpg';
import gallery06 from '../assets/images/gallery/drop-06.jpg';
import gallery07 from '../assets/images/gallery/drop-07.jpg';
import gallery08 from '../assets/images/gallery/drop-08.jpg';
import gallery09 from '../assets/images/gallery/drop-09.jpg';
import gallery10 from '../assets/images/gallery/drop-10.jpg';
import gallery11 from '../assets/images/gallery/drop-11.jpg';
import gallery12 from '../assets/images/gallery/drop-12.jpg';

// The drop: one poster per print.
const drop = [
  {
    name: 'KALYENOIR',
    poster: posterKalyenoir,
    alt: 'KalyeNoir poster: the wordmark stacked across a Manila street sign',
    href: '/products/kalyenoir-tee',
    line: 'Real dreams, same sky',
  },
  {
    name: 'MEDUSA',
    poster: posterMedusa,
    alt: 'Medusa poster: a hand-drawn gorgon with snakes for hair',
    href: '/products/medusa-tee',
    line: 'Not your myth',
  },
  {
    name: 'MANILA',
    poster: posterManila,
    alt: 'Manila poster: a jeepney on a crowded Manila street',
    href: '/products/manila-tee',
    line: 'The city never sleeps',
  },
];

const gallery = [
  { src: gallery01, alt: 'Crew seated on stone steps in Kalye Noir tees' },
  { src: gallery02, alt: 'Back prints of Kalye Noir tees against a stone archway' },
  { src: gallery03, alt: 'Crew walking a stone path in Kalye Noir tees' },
  { src: gallery04, alt: 'MEDUSA back print on a brick path' },
  { src: gallery05, alt: 'Crew on the steps below a stone wall' },
  { src: gallery06, alt: 'KALYENOIR tee on a Manila street beside a blue car' },
  { src: gallery07, alt: 'Crew resting on the steps beneath a tree' },
  { src: gallery08, alt: 'Crew on the steps against a bright sky' },
  { src: gallery09, alt: 'Crew grouped on the stone steps' },
  { src: gallery10, alt: 'Crew throwing peace signs on the steps' },
  { src: gallery11, alt: 'Crew laughing on the stone steps' },
  { src: gallery12, alt: 'Crew by a gate on a Manila street' },
];

const marquee = ['Kalye Noir', ...taglines, 'Street wear · Manila', 'Order by request'];
---

<MainLayout title={site.title} description={site.description}>
  <section data-banner class="grain relative overflow-hidden bg-ink text-paper">
    <span class="absolute bottom-0 left-8 h-24 w-px bg-registration/70 sm:left-12"></span>
    <span class="absolute bottom-0 right-8 h-24 w-px bg-registration/70 sm:right-12"></span>

    <div
      class="relative overflow-hidden"
      role="group"
      aria-roledescription="carousel"
      aria-label="Kalye Noir crew photos"
    >
      <div
        data-banner-track
        class="flex transition-transform duration-700 ease-in-out motion-reduce:transition-none"
      >
        <div
          class="w-full shrink-0"
          role="group"
          aria-roledescription="slide"
          aria-label="Photo 1 of 2"
        >
          <Image
            src={homeBannerOne}
            alt="Five people wearing Kalye Noir tees standing in front of a jeepney on a Manila street"
            widths={[480, 768, 1024, 1280]}
            sizes="100vw"
            format="webp"
            fetchpriority="high"
            loading="eager"
            class="h-[360px] w-full object-cover sm:h-[460px] lg:h-[560px]"
          />
        </div>
        <div
          class="w-full shrink-0"
          role="group"
          aria-roledescription="slide"
          aria-label="Photo 2 of 2"
        >
          <Image
            src={homeBannerTwo}
            alt="The Kalye Noir crew crossing a Manila street in their tees, seen from behind"
            widths={[480, 768, 1024, 1206]}
            sizes="100vw"
            format="webp"
            loading="lazy"
            decoding="async"
            class="h-[360px] w-full object-cover sm:h-[460px] lg:h-[560px]"
          />
        </div>
      </div>
    </div>

    <div class="wrap pb-14 pt-5 lg:pb-20 lg:pt-6">
      <div class="meta flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-paper/75">
        <span>The crew, Manila</span>
        <span class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <span data-banner-count>01 / 02</span>
          <button
            type="button"
            data-banner-toggle
            hidden
            aria-label="Pause photo rotation"
            class="tap text-paper/75 underline decoration-paper/40 underline-offset-4 transition-colors hover:text-paper hover:decoration-paper"
          >
            Pause
          </button>
          <button
            type="button"
            data-banner-next
            hidden
            aria-label="Next photo"
            class="tap text-paper/75 underline decoration-paper/40 underline-offset-4 transition-colors hover:text-paper hover:decoration-paper"
          >
            Next
          </button>
          <span>Est. 2026</span>
          <span class="barcode h-3.5 w-16 text-paper/70"></span>
        </span>
      </div>

      <h1 class="display reveal mt-8 text-5xl sm:text-6xl lg:text-7xl xl:text-8xl">
        Nasa kalye<br />nangangarap
      </h1>

      <div class="reveal reveal-2 mt-9 flex flex-wrap gap-3">
        <a href="#drop" class="btn btn-invert">See the drop</a>
        <a href="#how-it-works" class="btn btn-ghost">How ordering works</a>
      </div>

      <div class="meta reveal reveal-3 mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-paper/70">
        <span>14.5995° N, 120.9842° E</span>
        <svg viewBox="0 0 24 24" width="18" height="18" class="text-paper/60">
          <path
            fill="currentColor"
            d="M16.36 14c.08-.66.14-1.32.14-2c0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2m-5.15 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56M14.34 14H9.66c-.1-.66-.16-1.32-.16-2c0-.68.06-1.35.16-2h4.68c.09.65.16 1.32.16 2c0 .68-.07 1.34-.16 2M12 19.96c-.83-1.2-1.5-2.53-1.91-3.96h3.82c-.41 1.43-1.08 2.76-1.91 3.96M8 8H5.08A7.923 7.923 0 0 1 9.4 4.44C8.8 5.55 8.35 6.75 8 8m-2.92 8H8c.35 1.25.8 2.45 1.4 3.56A8.008 8.008 0 0 1 5.08 16m-.82-2C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2c0 .68.06 1.34.14 2M12 4.03c.83 1.2 1.5 2.54 1.91 3.97h-3.82c.41-1.43 1.08-2.77 1.91-3.97M18.92 8h-2.95a15.65 15.65 0 0 0-1.38-3.56c1.84.63 3.37 1.9 4.33 3.56M12 2C6.47 2 2 6.5 2 12a10 10 0 0 0 10 10a10 10 0 0 0 10-10A10 10 0 0 0 12 2"
          />
        </svg>
        <span>Heavyweight cotton · S–2XL</span>
      </div>
    </div>
  </section>

  <script>
    const banner = document.querySelector('[data-banner]');
    const track = document.querySelector<HTMLElement>('[data-banner-track]');
    const count = document.querySelector<HTMLElement>('[data-banner-count]');
    const toggle = document.querySelector<HTMLElement>('[data-banner-toggle]');
    const next = document.querySelector<HTMLElement>('[data-banner-next]');

    if (banner && track && count && toggle && next) {
      const slides = [...track.children];
      let index = 0;
      let timer: ReturnType<typeof setInterval> | undefined;

      const show = (i: number) => {
        index = (i + slides.length) % slides.length;
        track.style.transform = `translateX(-${index * 100}%)`;
        count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      };

      const stop = () => clearInterval(timer);
      const start = () => {
        stop();
        timer = setInterval(() => show(index + 1), 5000);
      };

      if (slides.length > 1) {
        toggle.hidden = false;
        next.hidden = false;

        next.addEventListener('click', () => {
          show(index + 1);
          if (!banner.classList.contains('banners-paused')) start();
        });

        toggle.addEventListener('click', () => {
          const paused = banner.classList.toggle('banners-paused');
          if (paused) stop();
          else start();
          toggle.textContent = paused ? 'Play' : 'Pause';
          toggle.setAttribute('aria-label', paused ? 'Play photo rotation' : 'Pause photo rotation');
        });

        start();
      }
    }
  </script>

  <div class="overflow-hidden border-y border-ink bg-registration py-3">
    <div
      class="marquee flex w-max motion-reduce:animate-none hover:[animation-play-state:paused] focus-within:[animation-play-state:paused]"
    >
      {
        [0, 1].map((copyIndex) => (
          <div class="flex shrink-0" aria-hidden={copyIndex > 0 ? 'true' : undefined}>
            {marquee.map((item) => (
              <span class="meta mx-7 flex items-center gap-7 whitespace-nowrap font-semibold text-paper">
                {item}
                <span class="inline-block h-1.5 w-1.5 rotate-45 bg-paper/70" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <section id="drop" class="wrap py-16 lg:py-24">
    <header class="flex flex-wrap items-end justify-between gap-6 border-b-2 border-ink pb-5">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="inline-block h-1.5 w-1.5 rotate-45 bg-registration" aria-hidden="true"></span>
          <span class="meta text-registration font-semibold">Batch 001 Active · Manila Pressing</span>
        </div>
        <h2 class="display text-4xl sm:text-5xl">The drop</h2>
        <p class="meta mt-1 text-muted">003 Prints · Custom Screen-Print Tees</p>
      </div>
      <p class="meta text-muted">Heavyweight cotton · S–2XL</p>
    </header>

    <ul class="mt-12 grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      {
        drop.map((print, i) => (
          <li class={i === 1 ? 'lg:mt-12' : ''}>
            <a href={print.href} class="group block">
              <div class="relative overflow-hidden bg-ink">
                <Image
                  src={print.poster}
                  alt={print.alt}
                  widths={[300, 450, 600]}
                  sizes="(min-width: 1024px) 30vw, 92vw"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[3/4] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                />
                <span class="absolute left-0 top-0 h-1 w-0 bg-registration transition-all duration-500 group-hover:w-full" />
                <span class="meta absolute right-3 top-3 text-paper/70">
                  {String(i + 1).padStart(3, '0')}
                </span>
              </div>

              <div class="mt-4 flex items-baseline justify-between gap-4">
                <h3 class="display text-2xl transition-colors duration-200 group-hover:text-registration">
                  {print.name}
                </h3>
                <span class="meta text-xs text-muted transition-colors group-hover:text-registration">
                  View Tee →
                </span>
              </div>
              <p class="meta mt-1 text-muted">{print.line} · S–2XL</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="field-notes" class="bg-ink py-16 text-paper lg:py-24">
    <div class="wrap">
      <header class="flex flex-wrap items-end justify-between gap-6 border-b border-paper/20 pb-5">
        <div>
          <div class="mb-2 flex items-center gap-2">
            <span class="inline-block h-1.5 w-1.5 rotate-45 bg-registration" aria-hidden="true"></span>
            <span class="meta font-semibold text-paper/70">Batch 001 · Manila</span>
          </div>
          <h2 class="display text-4xl sm:text-5xl">Field notes</h2>
          <p class="meta mt-1 text-paper/70">Twelve frames from the drop shoot</p>
        </div>
        <p class="meta text-paper/70">Off the press, onto the street</p>
      </header>

      <ul class="mt-8 columns-2 gap-2 [&>li]:mb-2 [&>li]:break-inside-avoid md:columns-3 lg:columns-4">
        {
          gallery.map((photo, i) => (
            <li>
              <figure class="group">
                <div class="relative overflow-hidden bg-paper/5">
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    widths={[320, 480, 640, 960]}
                    sizes="(min-width: 1024px) 24vw, (min-width: 768px) 32vw, 46vw"
                    format="webp"
                    loading="lazy"
                    decoding="async"
                    class="w-full transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  />
                  <span class="absolute left-0 top-0 h-1 w-0 bg-registration transition-all duration-500 group-hover:w-full" />
                </div>
                <figcaption class="meta mt-1.5 text-paper/70">
                  {String(i + 1).padStart(2, '0')}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="how-it-works" class="border-t border-line bg-line/20 py-16 lg:py-24">
    <div class="wrap">
      <header class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-6">
        <div>
          <h2 class="display text-3xl sm:text-4xl">How Ordering Works</h2>
          <p class="meta mt-1 text-muted">Small-Batch Streetwear · Made in Manila</p>
        </div>
        <span class="meta text-xs text-muted">Order by Request Protocol</span>
      </header>

      <div class="mt-10 grid gap-8 md:grid-cols-3">
        <div class="border-t-2 border-ink pt-6">
          <span class="font-display text-4xl text-registration">01</span>
          <h3 class="font-condensed text-base font-semibold uppercase tracking-[0.16em] text-ink mt-2">
            Select Piece & Size
          </h3>
          <p class="mt-2 text-sm text-ink/75 leading-relaxed">
            Choose your print and preferred size (S–2XL). Add to your order request slip without immediate charge.
          </p>
        </div>

        <div class="border-t-2 border-ink pt-6">
          <span class="font-display text-4xl text-registration">02</span>
          <h3 class="font-condensed text-base font-semibold uppercase tracking-[0.16em] text-ink mt-2">
            Send Request Slip
          </h3>
          <p class="mt-2 text-sm text-ink/75 leading-relaxed">
            Submit your contact details and address at checkout. Your order queues straight into our workshop batch.
          </p>
        </div>

        <div class="border-t-2 border-ink pt-6">
          <span class="font-display text-4xl text-registration">03</span>
          <h3 class="font-condensed text-base font-semibold uppercase tracking-[0.16em] text-ink mt-2">
            Confirm & Dispatch
          </h3>
          <p class="mt-2 text-sm text-ink/75 leading-relaxed">
            A real person confirms stock and provides shipping numbers via email or message before dispatching from Manila.
          </p>
        </div>
      </div>

      <div class="mt-12 flex flex-wrap items-center justify-between gap-6 border-t border-line/60 pt-8">
        <p class="font-condensed text-xs uppercase tracking-[0.2em] text-ink/80">
          Ready to order? Browse the 3 drop pieces above or check the full catalog.
        </p>
        <a href="/products" class="btn btn-primary text-xs">
          Shop Now →
        </a>
      </div>
    </div>
  </section>
</MainLayout>
