---
import { Icon } from 'astro-icon/components';
import Container  from '../core/Container.astro';
import Plug from './Plug.astro';

const { footerSocials, footerLists, copyrightName, background, color, showPlug: showPlug = true } =
  Astro.props;

// size the link columns to the actual number of lists so nothing is left empty
const linkColumns = footerLists?.length ? `2fr repeat(${footerLists.length}, minmax(0, 1fr))` : '2fr';
---

<footer
  style={background && `--footer-bg:${background}; --footer-color:${color}`}
>
  <Container>
    <div class="footer-grid__container" style={`--footer-link-columns:${linkColumns}`}>
      <div class="footer-brand__container">
        <div>
          <slot name="logo" />
        </div>
        <p class="footer-tagline">Nasa kalye nangangarap.<br />Est. 2026 · Manila</p>
        <ul class="footer-socials__list">
          {
            footerSocials?.map((social) => (
              <li class="footer-socials__item">
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-socials__link"
                  title={`Open ${social.name} profile`}
                >
                  <Icon name={social.icon} width={22} height={22} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        footerLists?.map((list) => (
          <div>
            <p class="footer-list__title">{list.title}</p>
            <ul class="footer-link__list">
              {list.items.map((item) => (
                <li>
                  <a href={item.slug}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="footer-copyright__container">
      {showPlug && <Plug/>}
      <p>Copyright &copy; {new Date().getFullYear()} {copyrightName}</p>
      <p class="footer-coords">14.5995° N — 120.9842° E</p>
    </div>

  </Container>
</footer>

<style>
  footer {
    --footer-bg: var(--kn-ink);
    --footer-color: var(--kn-paper);
    margin-top: var(--section-margin);
    background-color: var(--footer-bg);
    color: var(--footer-color);
    border-top: 2px solid var(--kn-red);
  }
  .footer-grid__container {
    padding: clamp(3rem, 8vw, 6rem) 0 1.5rem 0;
    display: grid;
    gap: var(--theme-grid-gap);
    grid-template-columns: var(--footer-link-columns, 2fr 1fr 1fr 1fr);
  }
  .footer-tagline {
    font-family: var(--theme-font-mono);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.7;
    color: color-mix(in srgb, var(--kn-paper) 62%, var(--kn-ink));
    margin: 0.75rem 0;
  }
  .footer-list__title {
    font-family: var(--theme-font-mono);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--kn-red-bright);
    margin-bottom: 0.85rem;
  }
  .footer-socials__list {
    margin: 1rem 0;
    padding: 0;
    display: flex;
    list-style: none;
    gap: 0.75rem;
  }
  .footer-socials__link:hover {
    color: var(--kn-red-bright);
  }
  .footer-link__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-link__list li {
    margin-bottom: 0.6rem;
  }
  .footer-link__list li a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .footer-link__list li a:hover {
    border-color: var(--kn-red-bright);
  }
  .footer-copyright__container {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid color-mix(in srgb, var(--kn-paper) 22%, transparent);
  }
  .footer-copyright__container p {
    font-family: var(--theme-font-mono);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
    color: color-mix(in srgb, var(--kn-paper) 62%, var(--kn-ink));
  }
  @media (max-width: 768px) {
    .footer-grid__container :first-child {
      grid-column: 1/-1;
    }
    .footer-grid__container {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .footer-grid__container {
      grid-template-columns: 1fr;
    }
    .footer-copyright__container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
