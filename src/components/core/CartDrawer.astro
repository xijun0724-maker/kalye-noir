---
import { Button } from '@components/odyssey-theme';
---

<aside id="cartDrawer" class="cart-drawer" data-cart-drawer aria-label="Shopping cart">
	<div class="cart-drawer__scrim" data-cart-close></div>
	<div class="cart-drawer__panel" role="dialog" aria-modal="true">
		<div class="cart-drawer__head">
			<h2>Your Cart</h2>
			<button class="cart-drawer__close" type="button" data-cart-close aria-label="Close cart">×</button>
		</div>
		<div class="cart-drawer__body" data-cart-items></div>
		<div class="cart-drawer__foot">
			<p class="cart-drawer__note">Pricing confirmed per order. We'll follow up with payment details.</p>
			<Button href="/cart">View cart</Button>
		</div>
	</div>
</aside>
