---
import { footerLists, site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="font-display text-xl uppercase leading-none tracking-[0.18em]">{site.name}</p>
      <p class="mt-4 max-w-sm text-sm text-muted">{site.description}</p>
    </div>
    {
      footerLists.map((list) => (
        <div>
          <p class="label mb-4">{list.title}</p>
          <ul class="flex flex-col gap-3">
            {list.items.map((item) => (
              <li>
                <a href={item.href} class="tap text-sm text-muted transition-colors hover:text-ink">
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-line">
    <p class="wrap py-5 text-[0.6875rem] uppercase tracking-[0.18em] text-muted">
      © {year} {site.name}. All rights reserved.
    </p>
  </div>
</footer>
