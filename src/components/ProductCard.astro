---
import { Image } from 'astro:assets';
import type { Product } from '../data/catalog';
import { productArt } from '../data/productArt';

interface Props {
	product: Product;
	/** Above-the-fold cards: load eagerly so the grid's LCP image isn't deferred. */
	priority?: boolean;
}

const { product, priority = false } = Astro.props;
const sourceWidth = productArt[product.slug].width;

const reviews = 0;
---

<a href={`/products/${product.slug}`} class="group block text-center">
	<!-- Clean flatlay garment visual on white ground with DESIGN.md hairline border -->
	<div class="relative overflow-hidden bg-white p-3 border border-hairline">
		<Image
			src={productArt[product.slug]}
			alt={product.alt}
			widths={[200, 300, sourceWidth]}
			sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 48vw"
			format="webp"
			loading={priority ? 'eager' : 'lazy'}
			fetchpriority={priority ? 'high' : undefined}
			decoding="async"
			class="aspect-[4/5] w-full object-contain transition-transform duration-500 ease-out group-hover:scale-[1.04]"
		/>
	</div>

	<!-- Centered Product Info matching DESIGN.md typography -->
	<div class="pt-4 text-center">
		<!-- Title in Barlow Condensed tracked font -->
		<h2
			class="font-title text-xs uppercase tracking-[0.18em] font-semibold text-ink transition-colors group-hover:text-accent"
		>
			{product.title}
		</h2>

		<!-- 5-Star Rating matching registration red accent -->
		<div
			class="mt-1.5 flex items-center justify-center gap-1 text-xs"
			aria-label="5 out of 5 stars"
		>
			<span class="text-xs tracking-tight text-accent" aria-hidden="true">★★★★★</span>
			<span class="text-xs text-navy/80">({reviews})</span>
		</div>

		<!-- Price line: Current bold price and strikethrough regular price -->
		<div class="mt-1.5 flex items-baseline justify-center gap-2 text-xs">
			<span class="font-bold text-ink">₱{product.price}.00</span>
			<span class="text-navy line-through">₱350.00</span>
		</div>
	</div>
</a>
