---
import { getImage } from 'astro:assets';
import { productArt } from '../data/productArt';

const thumbnails = Object.fromEntries(
	await Promise.all(
		Object.entries(productArt).map(async ([slug, image]) => {
			const thumbnail = await getImage({
				src: image,
				width: 192,
				format: 'webp',
				quality: 80,
			});
			return [slug, thumbnail.src];
		}),
	),
);
---

<!-- Slide-Out Cart Drawer (Matches Laureti Image 2) -->
<div
	data-cart-drawer-root
	class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0"
	aria-hidden="true"
>
	<!-- Backdrop -->
	<div
		data-cart-backdrop
		class="absolute inset-0 bg-ink/50 backdrop-blur-xs transition-opacity cursor-pointer"
	></div>

	<!-- Drawer Panel -->
	<aside
		data-cart-panel
		class="absolute right-0 top-0 bottom-0 w-full max-w-sm sm:max-w-md bg-paper border-l border-hairline shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-out pointer-events-auto"
		role="dialog"
		aria-label="Shopping Cart"
		aria-modal="true"
	>
		<!-- Header: CART and Close Button -->
		<div class="flex items-center justify-between px-6 py-5 border-b border-hairline">
			<h2 class="font-title text-base font-bold uppercase tracking-[0.2em] text-ink">
				CART
			</h2>
			<button
				type="button"
				data-cart-close
				aria-label="Close cart"
				class="flex h-8 w-8 items-center justify-center text-xl text-navy hover:text-ink cursor-pointer transition-colors"
			>
				✕
			</button>
		</div>

		<!-- Items List -->
		<div
			data-cart-items-container
			data-thumbnail-sources={JSON.stringify(thumbnails)}
			class="flex-1 overflow-y-auto px-6 py-4 divide-y divide-hairline"
		>
			<!-- Populated via JavaScript -->
		</div>

		<!-- Footer Area -->
		<div class="border-t border-hairline px-6 py-5 bg-paper space-y-4">
			<!-- Order Note Accordion/Field -->
			<div>
				<details class="group">
					<summary class="font-title text-xs uppercase tracking-wider text-navy cursor-pointer flex items-center justify-between hover:text-ink">
						<span>Add order note</span>
						<span class="transition-transform group-open:rotate-180 text-xs">▾</span>
					</summary>
					<div class="mt-2">
						<textarea
							data-drawer-note
							rows="2"
							placeholder="Special delivery instructions, landmarks, or requests..."
							class="w-full text-xs p-2.5 bg-white border border-plate/80 rounded-none text-ink placeholder:text-navy/50 focus:border-ink focus:outline-none"
						></textarea>
					</div>
				</details>
			</div>

			<p class="text-xs text-navy/70 leading-normal">
				Taxes and shipping calculated at checkout
			</p>

			<!-- Action Buttons -->
			<div class="space-y-2 pt-2">
				<a
					href="/checkout"
					data-checkout-btn
					class="w-full bg-ink hover:bg-accent text-paper text-xs font-title font-semibold uppercase tracking-[0.24em] py-4 transition-colors text-center block rounded-none shadow-panel"
				>
					CHECKOUT · <span data-drawer-total>₱0.00</span>
				</a>

				<a
					href="/cart"
					data-view-cart-btn
					class="w-full text-navy hover:text-ink text-xs font-title uppercase tracking-[0.2em] py-2 transition-colors text-center block underline underline-offset-4"
				>
					View Full Cart →
				</a>
			</div>
		</div>
	</aside>
</div>

<script>
	import {
		isCartOpen,
		cartItems,
		removeFromCart,
		stepQty,
		orderNote,
		getCartItemPrice,
		cartSubtotal,
	} from '../stores/cartStore';
	import { products } from '../data/catalog';
	import { escapeHTML } from '../lib/escapeHTML';

	const root = document.querySelector<HTMLElement>('[data-cart-drawer-root]');
	const panel = document.querySelector<HTMLElement>('[data-cart-panel]');
	const backdrop = document.querySelector<HTMLElement>('[data-cart-backdrop]');
	const closeBtn = document.querySelector<HTMLElement>('[data-cart-close]');
	const itemsContainer = document.querySelector<HTMLElement>('[data-cart-items-container]');
	const drawerTotal = document.querySelector<HTMLElement>('[data-drawer-total]');
	const noteInput = document.querySelector<HTMLTextAreaElement>('[data-drawer-note]');

	const rawThumbnails: unknown = JSON.parse(itemsContainer?.dataset.thumbnailSources ?? '{}');
	const thumbnailSources = new Map<string, string>(Object.entries(rawThumbnails as Record<string, string>));

	function closeDrawer() {
		isCartOpen.set(false);
	}

	function openDrawer() {
		isCartOpen.set(true);
	}

	backdrop?.addEventListener('click', closeDrawer);
	closeBtn?.addEventListener('click', closeDrawer);

	// Sync note
	if (noteInput) {
		noteInput.value = orderNote.get();
		noteInput.addEventListener('input', () => orderNote.set(noteInput.value));
	}

	// Render items matching Image 2
	function renderItems() {
		if (!itemsContainer) return;
		const items = cartItems.get();

		if (!items.length) {
			itemsContainer.innerHTML = `
				<div class="py-16 text-center">
					<p class="font-title text-base font-bold uppercase tracking-wider text-ink">Your cart is empty</p>
					<p class="text-xs text-navy mt-1.5">Add a piece from Batch 001 to begin.</p>
					<a href="/products" data-cart-close class="btn btn-primary mt-6 inline-block text-xs py-2.5 px-6 uppercase tracking-wider">
						Shop Now
					</a>
				</div>
			`;
			if (drawerTotal) drawerTotal.textContent = '₱0.00';
			return;
		}

		itemsContainer.innerHTML = items
			.map(item => {
				const product = products.find(p => p.slug === item.slug);
				const title = product?.title ?? item.title;
				const image = thumbnailSources.get(item.slug) ?? '';
				const price = getCartItemPrice(item);
				// Variant is formatted e.g. "Black · M" -> extract size or show full
				const size = item.variant.includes('·')
					? item.variant.split('·').pop()?.trim().toUpperCase()
					: item.variant.toUpperCase();

				const fullSizeName: Record<string, string> = {
					XS: 'EXTRA SMALL',
					S: 'SMALL',
					M: 'MEDIUM',
					L: 'LARGE',
					XL: 'EXTRA LARGE',
					'2XL': '2 EXTRA LARGE',
				};
				const displaySize = (fullSizeName[size ?? ''] || size) ?? '';

				return `
					<div class="py-4 flex gap-4 items-start" data-sku="${escapeHTML(item.sku)}">
						<div class="h-20 w-16 sm:h-24 sm:w-20 bg-white border border-hairline shrink-0 p-1">
							<img
								src="${escapeHTML(image)}"
								alt="${escapeHTML(title)}"
								class="h-full w-full object-contain"
								loading="lazy"
							/>
						</div>
						<div class="flex-1 min-w-0">
							<h3 class="font-title text-xs sm:text-sm font-semibold uppercase tracking-wider text-ink truncate">
								${escapeHTML(title)}
							</h3>
							<p class="font-sans text-xs text-navy mt-0.5">
								₱${price.toFixed(2)}
							</p>
							<p class="font-title text-[11px] uppercase tracking-wider text-navy/70 mt-0.5">
								${escapeHTML(displaySize)}
							</p>
							<div class="mt-3 flex items-center gap-3">
								<div class="flex items-center justify-between border border-plate/80 w-24 h-8 px-2 bg-white text-ink text-xs">
									<button
										type="button"
										data-step="-1"
										class="text-sm text-navy hover:text-ink cursor-pointer leading-none p-1"
										aria-label="Decrease quantity"
									>
										−
									</button>
									<span class="font-title text-xs font-semibold text-ink">
										${item.qty}
									</span>
									<button
										type="button"
										data-step="1"
										class="text-sm text-navy hover:text-ink cursor-pointer leading-none p-1"
										aria-label="Increase quantity"
									>
										+
									</button>
								</div>
								<button
									type="button"
									data-remove
									class="text-xs text-navy hover:text-ink underline underline-offset-2 cursor-pointer transition-colors"
								>
									Remove
								</button>
							</div>
						</div>
					</div>
				`;
			})
			.join('');

		const total = cartSubtotal(items);
		if (drawerTotal) drawerTotal.textContent = `₱${total.toFixed(2)}`;
	}

	// Delegated item events (stepper & remove)
	itemsContainer?.addEventListener('click', e => {
		const target = e.target as HTMLElement;
		const line = target.closest<HTMLElement>('[data-sku]');
		if (!line) return;
		const sku = line.dataset.sku!;

		if (target.closest('[data-remove]')) {
			removeFromCart(sku);
			return;
		}

		const stepBtn = target.closest<HTMLElement>('[data-step]');
		if (stepBtn) {
			stepQty(sku, Number(stepBtn.dataset.step));
		}
	});

	// Subscribe to store
	cartItems.subscribe(() => {
		renderItems();
	});

	isCartOpen.subscribe(open => {
		if (!root || !panel) return;
		if (open) {
			renderItems();
			root.classList.remove('pointer-events-none', 'opacity-0');
			root.classList.add('pointer-events-auto', 'opacity-100');
			panel.classList.remove('translate-x-full');
			panel.classList.add('translate-x-0');
			document.body.style.overflow = 'hidden';
		} else {
			root.classList.remove('pointer-events-auto', 'opacity-100');
			root.classList.add('pointer-events-none', 'opacity-0');
			panel.classList.remove('translate-x-0');
			panel.classList.add('translate-x-full');
			document.body.style.overflow = '';
		}
	});

	// Global click listener for any [data-cart-open] button
	document.addEventListener('click', e => {
		const target = e.target as HTMLElement;
		if (target.closest('[data-cart-open]')) {
			e.preventDefault();
			openDrawer();
		}
		if (target.closest('[data-cart-close]')) {
			closeDrawer();
		}
	});

	// Escape closes drawer
	document.addEventListener('keydown', e => {
		if (e.key === 'Escape' && isCartOpen.get()) {
			closeDrawer();
		}
	});

	renderItems();
</script>
