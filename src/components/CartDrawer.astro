---
// Slide-out cart island. State lives in the nanostores cartStore; this component
// only renders handlers + list markup and subscribes to the store.
---

<div class="pointer-events-none fixed inset-0 z-50" data-cart-root aria-hidden="true">
  <div
    class="absolute inset-0 bg-ink/40 opacity-0 backdrop-blur-sm transition-opacity duration-300"
    data-cart-backdrop
  >
  </div>
  <aside
    data-cart-panel
    class="absolute right-0 top-0 flex h-full w-full max-w-md translate-x-full flex-col bg-paper shadow-2xl transition-transform duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Shopping cart"
  >
    <div class="flex items-center justify-between border-b border-line px-5 py-5">
      <h2 class="meta text-ink">Cart</h2>
      <button type="button" class="text-2xl leading-none" data-cart-close aria-label="Close cart">
        ×
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-5" data-cart-items></div>

    <div class="border-t border-line px-5 py-5">
      <label class="label mb-2 block" for="drawer-order-note">Add order note</label>
      <textarea
        id="drawer-order-note"
        data-cart-note
        rows="2"
        placeholder="How can we help you?"
        class="w-full border border-line bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-ink"
      ></textarea>
      <p class="meta mt-3 text-muted">Shipping estimated at checkout</p>
      <a href="/cart" class="btn btn-primary mt-4 w-full">View cart</a>
      <a href="/checkout" data-drawer-checkout class="btn btn-primary mt-2 w-full">Checkout</a>
    </div>
  </aside>
</div>

<script>
  import {
    isCartOpen,
    cartItems,
    cartCount,
    removeFromCart,
    setQty,
    orderNote,
  } from '../stores/cartStore';

  const root = document.querySelector<HTMLElement>('[data-cart-root]');
  if (root) {
    const backdrop = root.querySelector<HTMLElement>('[data-cart-backdrop]')!;
    const panel = root.querySelector<HTMLElement>('[data-cart-panel]')!;
    const list = root.querySelector<HTMLElement>('[data-cart-items]')!;
    const note = root.querySelector<HTMLTextAreaElement>('[data-cart-note]');
    const checkout = root.querySelector<HTMLAnchorElement>('[data-drawer-checkout]');

    const close = () => isCartOpen.set(false);
    root.querySelector('[data-cart-close]')?.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-cart-open]')) isCartOpen.set(true);
    });

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const line = t.closest<HTMLElement>('[data-sku]');
      if (!line) return;
      const sku = line.dataset.sku!;
      if (t.closest('[data-remove]')) return removeFromCart(sku);
      const step = t.closest<HTMLElement>('[data-step]');
      if (step) {
        const current = cartItems.get().find((i) => i.sku === sku);
        if (current) setQty(sku, current.qty + Number(step.dataset.step));
      }
    });

    if (note) {
      note.value = orderNote.get();
      note.addEventListener('input', () => orderNote.set(note.value));
    }

    function render() {
      const items = cartItems.get();
      list.innerHTML = items.length
        ? items
            .map(
              (i) => `
          <div class="flex gap-4 border-b border-line py-4" data-sku="${i.sku}">
            <img src="${i.image}" alt="" width="72" height="90" loading="lazy" class="h-[90px] w-[72px] shrink-0 bg-white object-contain p-1.5" />
            <div class="flex min-w-0 flex-1 flex-col">
              <p class="font-condensed text-[13px] font-semibold uppercase leading-snug tracking-[0.12em]">${i.title}</p>
              <p class="meta mt-1.5 text-muted">${i.variant}</p>
              <div class="mt-auto flex items-center gap-4 pt-3">
                <div class="flex items-stretch border border-line">
                  <button type="button" data-step="-1" class="h-8 w-8 text-lg leading-none transition-colors hover:bg-line/40" aria-label="Decrease quantity">−</button>
                  <span class="flex w-10 items-center justify-center text-sm">${i.qty}</span>
                  <button type="button" data-step="1" class="h-8 w-8 text-lg leading-none transition-colors hover:bg-line/40" aria-label="Increase quantity">+</button>
                </div>
                <button type="button" data-remove class="meta text-muted underline underline-offset-4 transition-colors hover:text-registration">Remove</button>
              </div>
            </div>
          </div>`
            )
            .join('')
        : '<p class="py-16 text-center text-sm text-muted">Your cart is empty.</p>';

      const count = cartCount.get();
      if (checkout) {
        checkout.textContent = count
          ? `Checkout · ${count} ${count === 1 ? 'item' : 'items'}`
          : 'Checkout';
        checkout.classList.toggle('pointer-events-none', count === 0);
        checkout.classList.toggle('opacity-40', count === 0);
        checkout.setAttribute('aria-disabled', String(count === 0));
      }
    }

    const unsubOpen = isCartOpen.subscribe((open) => {
      root.setAttribute('aria-hidden', String(!open));
      root.classList.toggle('pointer-events-none', !open);
      root.classList.toggle('pointer-events-auto', open);
      backdrop.classList.toggle('opacity-0', !open);
      panel.classList.toggle('translate-x-full', !open);
      document.body.classList.toggle('overflow-hidden', open);
    });

    const unsubItems = cartItems.subscribe(render);
    render();
    document.addEventListener(
      'astro:before-swap',
      () => {
        unsubOpen();
        unsubItems();
      },
      { once: true }
    );
  }
</script>
