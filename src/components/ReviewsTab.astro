---
// Vertical edge tab + slide-over review panel. Reads from src/data/reviews.ts —
// shows an empty state until real reviews exist.
import { reviews } from '../data/reviews';
---

<div class="fixed inset-y-0 right-0 z-40 flex items-center">
  <button
    type="button"
    data-reviews-toggle
    aria-controls="reviews-panel"
    aria-expanded="false"
    style="writing-mode: vertical-rl"
    class="flex items-center gap-2 rounded-l-md bg-registration px-2.5 py-5 text-paper shadow-[0_14px_35px_-14px_rgba(0,0,0,0.65)] transition-colors hover:bg-ink"
  >
    <span aria-hidden="true" class="text-sm leading-none">★</span>
    <span class="meta font-semibold text-inherit tracking-[0.22em]">Reviews</span>
  </button>
</div>

<aside
  id="reviews-panel"
  data-reviews-panel
  aria-hidden="true"
  aria-label="Reviews"
  class="pointer-events-none fixed inset-y-0 right-0 z-50 flex w-full max-w-md translate-x-full flex-col bg-paper shadow-2xl transition-transform duration-300"
>
  <div class="flex items-center justify-between border-b border-line px-5 py-4">
    <h2 class="meta text-ink">Reviews</h2>
    <button type="button" data-reviews-close class="text-2xl leading-none" aria-label="Close reviews">
      ×
    </button>
  </div>
  <div class="flex-1 overflow-y-auto px-5 py-4" data-reviews-list>
    {
      reviews.length ? (
        reviews.map((review) => (
          <article class="border-b border-line py-5">
            <p class="text-registration" aria-label={`${review.rating} out of 5`}>
              {'★'.repeat(review.rating)}
              {'☆'.repeat(5 - review.rating)}
            </p>
            <p class="mt-2 text-sm font-semibold">{review.name}</p>
            <p class="meta mt-1 text-muted">
              {review.product} · {review.date}
            </p>
            <p class="mt-2 text-sm leading-relaxed">{review.body}</p>
          </article>
        ))
      ) : (
        <div class="py-16 text-center">
          <p class="text-3xl text-registration" aria-hidden="true">
            ★
          </p>
          <p class="mt-4 text-sm font-semibold">No reviews yet</p>
          <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-muted">
            We're just getting started. Ordered a tee? Reply to your confirmation email with a photo
            and we'll feature it here.
          </p>
        </div>
      )
    }
  </div>
</aside>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-reviews-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-reviews-panel]');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.setAttribute('aria-hidden', String(!open));
      panel.classList.toggle('pointer-events-none', !open);
      panel.classList.toggle('pointer-events-auto', open);
      panel.classList.toggle('translate-x-full', !open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => setOpen(panel.getAttribute('aria-hidden') === 'true'));
    panel.querySelector('[data-reviews-close]')?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  }
</script>
