---
import { Container, Button } from '@components/odyssey-theme';
---

<Container>
	<section class="hero-section__section">
		<div class="hero-section__text">
			<p class="hero-section__est">EST. 2026</p>
			<h1>Kalye Noir</h1>
			<p class="hero-section__tagline">
				Street wear — Manila. Late nights. Early dreams. Real streets,
				real stories. Not your myth.
			</p>
			<div class="hero-btns__container">
				<Button href="/products" customIcon
					>Shop Products
					<Fragment slot="icon">
						<svg xmlns="http://www.w3.org/2000/svg" width="18px" height="18px" viewBox="0 0 24 24"><path fill="currentColor" d="M8.59 16.59L13.17 12L8.59 7.41L10 6l6 6l-6 6z"/></svg>
					</Fragment>
				</Button>
				<Button href="/products#order" unelevated>Order Yours</Button>
			</div>
		</div>
		<div class="hero-section__image">
			<picture>
				<img
					src="/assets/images/products/kalye-noir-page-01.png"
					alt="Kalye Noir poster — beauty in chaos"
					id="home-hero-image"
				/>
			</picture>
		</div>
	</section>
</Container>

<style>
	.hero-section__section {
		margin: var(--section-margin) auto;
		min-height: clamp(80vh, 100vw, calc(100vh - var(--navbar-height)));
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 1rem;
	}
	.hero-section__text {
		justify-self: center;
		max-width: 25rem;
	}
	.hero-section__est {
		font-size: var(--font-size-sm);
		letter-spacing: 0.35em;
		opacity: 0.55;
	}
	.hero-section__tagline {
		opacity: 0.8;
	}
	.hero-btns__container {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.hero-section__image {
		display: flex;
	}
	.hero-section__image {
		overflow: hidden;
		border-radius: var(--theme-shape-radius);
	}
	.hero-section__image img {
		width: 100%;
		height: 100%;
		max-height: 80vh;
		object-fit: cover;
		filter: saturate(0.9) contrast(0.98);
		transition:
			transform var(--theme-hover-zoom, 0.6s ease),
			filter 0.45s ease;
	}
	.hero-section__image img:hover {
		transform: scale(1.03);
		filter: saturate(1) contrast(1.05);
	}
	@media (max-width: 768px) {
		.hero-section__section {
			grid-template-columns: 1fr;
		}
	}
</style>
