---
---

<button
	type="button"
	data-cart-open
	aria-label="Open shopping cart"
	class="relative flex items-center justify-center text-navy transition-colors hover:text-ink cursor-pointer p-1"
>
	<svg
		viewBox="0 0 24 24"
		width="22"
		height="22"
		fill="none"
		stroke="currentColor"
		stroke-width="1.8"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
		<path d="M3 6h18"></path>
		<path d="M16 10a4 4 0 0 1-8 0"></path>
	</svg>
	<span
		class="absolute -right-1.5 -top-1.5 flex h-4 min-w-[1rem] items-center justify-center rounded-full bg-accent px-1 text-center font-title text-[10px] font-bold leading-none text-white shadow-xs"
		data-cart-count
		style="display:none"
	></span>
</button>

<style>
	@keyframes cart-badge-pop {
		0% {
			transform: scale(1);
		}
		40% {
			transform: scale(1.35);
		}
		100% {
			transform: scale(1);
		}
	}
	.cart-badge-pulse {
		animation: cart-badge-pop 0.4s ease;
	}
	@media (prefers-reduced-motion: reduce) {
		.cart-badge-pulse {
			animation: none;
		}
	}
</style>

<script>
	import { cartCount, isCartOpen } from '../stores/cartStore';

	const btn = document.querySelector<HTMLButtonElement>('[data-cart-open]');
	const badge = document.querySelector<HTMLElement>('[data-cart-count]');

	btn?.addEventListener('click', e => {
		e.preventDefault();
		isCartOpen.set(true);
	});

	if (badge) {
		cartCount.subscribe(n => {
			badge.textContent = String(n);
			badge.style.display = n === 0 ? 'none' : 'inline-flex';
			if (n > 0) {
				badge.classList.remove('cart-badge-pulse');
				void badge.offsetWidth;
				badge.classList.add('cart-badge-pulse');
			}
		});
	}
</script>
