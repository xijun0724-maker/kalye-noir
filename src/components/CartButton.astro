---
---

<button
  type="button"
  data-cart-open
  aria-label="Open cart"
  class="relative text-ink/80 transition-colors before:absolute before:-inset-3 before:content-[''] hover:text-ink"
>
  <svg viewBox="0 0 24 24" width="22" height="22">
    <path
      fill="currentColor"
      d="M17 18a2 2 0 0 1 2 2a2 2 0 0 1-2 2a2 2 0 0 1-2-2c0-1.11.89-2 2-2M1 2h3.27l.94 2H20a1 1 0 0 1 1 1c0 .17-.05.34-.12.5l-3.58 6.47c-.34.61-1 1.03-1.75 1.03H8.1l-.9 1.63l-.03.12a.25.25 0 0 0 .25.25H19v2H7a2 2 0 0 1-2-2c0-.35.09-.68.24-.96l1.36-2.45L3 4H1zm6 16a2 2 0 0 1 2 2a2 2 0 0 1-2 2a2 2 0 0 1-2-2c0-1.11.89-2 2-2m9-7l2.78-5H6.14l2.36 5z"
    />
  </svg>
  <span
    class="absolute -right-2 -top-2 min-w-[1.1rem] items-center justify-center rounded-full bg-registration px-1 text-center text-[0.6875rem] font-bold leading-[1.1rem] text-paper"
    data-cart-count
    style="display:none"
  >
  </span>
</button>

<script>
  import { cartCount } from '../stores/cartStore';

  const badge = document.querySelector<HTMLElement>('[data-cart-count]');
  if (badge) {
    cartCount.subscribe((n) => {
      badge.textContent = String(n);
      badge.style.display = n === 0 ? 'none' : 'inline-flex';
    });
  }
</script>
