# Resend email delivery (required for the checkout order emails).
# Get a key from https://resend.com/api-keys and set RESEND_API_KEY in
# Netlify site settings (or locally when running `netlify dev`).
RESEND_API_KEY=

# Optional verified "From" address. If unset the function sends from the
# Resend sandbox domain (onboarding@resend.dev), which can only reach the
# account owner's email and Resend test inboxes — not kalyenoirorders@gmail.com
# or real customers. For real delivery, verify a domain in Resend and set this
# to an address at that domain, e.g. "KALYE NOIR" <orders@yourdomain.com>.
# RESEND_FROM=
