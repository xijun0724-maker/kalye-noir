# Kalye Noir Discord Bot Environment Configuration

# 1. Discord Bot Token (from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=your_bot_token_here

# 2. Discord Application / Client ID (from Discord Developer Portal -> General Information)
DISCORD_CLIENT_ID=your_client_id_here

# 3. Discord Server (Guild) ID where the bot operates (Right-click server -> Copy Server ID)
DISCORD_GUILD_ID=your_guild_id_here

# 4. Discord Channel ID where new order alerts will be sent (Right-click channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=your_channel_id_here

# 5. Local Port for receiving order webhooks from website / worker (default: 4323)
PORT=4323

# 6. Optional secret key to authenticate POST /api/order requests
ORDER_API_SECRET=
